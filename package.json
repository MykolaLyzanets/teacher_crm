{
  "name": "teacher_crm",
  "private": true,
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.2",
    "esbuild": "^0.20.1",
    "sass": "1.77.8"
  },
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --outdir=app/assets/builds/js --minify",
    "build:css": "sass ./app/assets/stylesheets/application.sass.scss:./app/assets/builds/css/application.min.css ./app/assets/stylesheets/home.sass.scss:./app/assets/builds/css/home.min.css ./app/assets/stylesheets/auth.sass.scss:./app/assets/builds/css/auth.min.css ./app/assets/stylesheets/app.sass.scss:./app/assets/builds/css/app.min.css ./app/assets/stylesheets/pages/students.scss:./app/assets/builds/css/students.min.css ./app/assets/stylesheets/pages/teachers.scss:./app/assets/builds/css/teachers.min.css ./app/assets/stylesheets/pages/calendar.scss:./app/assets/builds/css/calendar.min.css ./app/assets/stylesheets/pages/dashboard.scss:./app/assets/builds/css/dashboard.min.css ./app/assets/stylesheets/pages/placeholder.scss:./app/assets/builds/css/placeholder.min.css ./app/assets/stylesheets/pages/student_portal.scss:./app/assets/builds/css/student_portal.min.css ./app/assets/stylesheets/pages/lessons.scss:./app/assets/builds/css/lessons.min.css ./app/assets/stylesheets/pages/payments.scss:./app/assets/builds/css/payments.min.css ./app/assets/stylesheets/pages/settings.scss:./app/assets/builds/css/settings.min.css --no-source-map --load-path=node_modules --style compressed"
  }
}
