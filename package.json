{
  "name": "teacher_crm",
  "private": true,
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.2",
    "esbuild": "^0.20.1",
    "sass": "1.77.8"
  },
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --outdir=app/assets/builds/js --minify",
    "build:css": "sass ./app/assets/stylesheets/application.sass.scss:./app/assets/builds/css/application.min.css --no-source-map --load-path=node_modules --style compressed"
  }
}
