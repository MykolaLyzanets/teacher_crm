footer.footer
  .container
    .footer-grid.footer-grid--v5
      .footer-brand
        = render 'layouts/logo'
        p.type-small = t('footer.tagline')
      .footer-col
        h5 = t('footer.product')
        a href="#tutors" = t('footer.features')
        a href="#pricing" = t('footer.pricing')
        a href="#product" = t('footer.updates')
      .footer-col
        h5 = t('footer.resources')
        = mail_to 'hello@danlio.com', t('footer.help_center')
        = mail_to 'hello@danlio.com', t('footer.contact')
      .footer-col
        h5 = t('footer.legal')
        a href="#privacy" = t('footer.privacy')
        a href="#terms" = t('footer.terms')
    p.copy = t('footer.copyright', year: Time.current.year)
