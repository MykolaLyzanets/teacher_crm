.lt-add-lesson
  input type="text" placeholder=t('app.lesson_types.lesson_name_placeholder') aria-label=t('app.lesson_types.new_lesson_name') autocomplete="off" data-lesson-types-target="newSubject" data-action="keydown.enter->lesson-types#addSubject:prevent:stop input->lesson-types#stopBubble:stop change->lesson-types#stopBubble:stop"
  button.lt-add-lesson__btn type="button" data-action="click->lesson-types#addSubject:prevent:stop"
    = icon_tag 'plus', size: 16
    span = t('app.lesson_types.add_lesson')
  p.lt-field-error hidden="hidden" data-lesson-types-target="addError"
