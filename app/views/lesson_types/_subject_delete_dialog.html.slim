- close_path = settings_lesson_subject_delete_dialog_path(dismiss: 1)

.danlio-modal.danlio-modal--sm data-controller="modal" data-lesson-types-target="subjectDeleteDialog" data-subject=@subject
  a.danlio-modal__backdrop href=close_path tabindex="-1" aria-label=t('app.common.close') data-modal-dismiss="true" data-turbo="true" data-turbo-frame="lesson_subject_delete_dialog"
  .danlio-modal__card role="dialog" aria-modal="true" aria-labelledby="delete-lesson-subject-title"
    .danlio-modal__head
      h2#delete-lesson-subject-title.danlio-modal__title = t('app.lesson_types.delete_lesson_title')
      a.danlio-modal__close href=close_path aria-label=t('app.common.close') data-modal-dismiss="true" data-turbo="true" data-turbo-frame="lesson_subject_delete_dialog"
        = icon_tag 'x', size: 20
    .danlio-modal__body
      p.danlio-modal__copy = t('app.lesson_types.delete_lesson_text')
      p.danlio-modal__copy
        span.lt-modal__subject-name data-lesson-types-target="subjectDeleteName" = @subject.present? ? "“#{@subject}”" : nil
      .danlio-modal__actions
        a.danlio-modal__btn.danlio-modal__btn--secondary href=close_path data-turbo="true" data-turbo-frame="lesson_subject_delete_dialog" = t('app.common.cancel')
        button.danlio-modal__btn.danlio-modal__btn--danger type="button" data-action="lesson-types#confirmDeleteSubject" = t('app.lesson_types.delete_lesson_confirm')
