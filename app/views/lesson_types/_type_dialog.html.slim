- close_path = settings_lesson_type_dialog_path(dismiss: 1)
- creating = @lesson_type_id.blank?
- presets = [{ key: 'individual', mode: 'individual', duration: 60 }, { key: 'group', mode: 'group', duration: 60 }, { key: 'speaking_club', mode: 'group', duration: 60 }, { key: 'intensive', mode: 'individual', duration: 60 }, { key: 'trial', mode: 'individual', duration: 30 }]

.danlio-modal.danlio-modal--md.danlio-modal--lesson-type data-controller="modal" data-lesson-types-target="dialog" data-subject=@subject data-subject-id=@subject_id data-id=@lesson_type_id
  a.danlio-modal__backdrop href=close_path tabindex="-1" aria-label=t('app.common.close') data-modal-dismiss="true" data-turbo="true" data-turbo-frame="lesson_type_dialog"
  .danlio-modal__card role="dialog" aria-modal="true" aria-labelledby="lesson-type-dialog-title"
    .danlio-modal__head
      div
        h2#lesson-type-dialog-title.danlio-modal__title data-lesson-types-target="dialogTitle" = t('app.lesson_types.add_title')
        p.danlio-modal__desc data-lesson-types-target="dialogSubject" = @subject
      a.danlio-modal__close href=close_path aria-label=t('app.common.close') data-modal-dismiss="true" data-turbo="true" data-turbo-frame="lesson_type_dialog"
        = icon_tag 'x', size: 20
    form.danlio-modal__form data-action="submit->lesson-types#submitDialog"
      .danlio-modal__body
        p.lt-field-error hidden="hidden" data-lesson-types-target="formError"
        .lt-name-block
          label.lt-field
            span
              = t('app.lesson_types.name')
              abbr.lt-req *
            input type="text" placeholder=t('app.lesson_types.name_placeholder') data-lesson-types-target="name" data-action="input->lesson-types#syncPresetButtons" data-modal-focus="true"
            p.lt-field-error hidden="hidden" data-lesson-types-target="nameError"
          - if creating
            .lt-presets role="group" aria-label=t('app.lesson_types.quick_picks') data-lesson-types-target="namePresets"
              - presets.each do |preset|
                button.lt-preset type="button" data-action="lesson-types#applyPreset" data-name=t("app.lesson_types.preset_#{preset[:key]}") data-mode=preset[:mode] data-duration=preset[:duration]
                  = t("app.lesson_types.preset_#{preset[:key]}")
        fieldset.lt-participation
          legend
            = t('app.lesson_types.participation')
            abbr.lt-req *
          .lt-participation__grid role="radiogroup"
            label.lt-participation__card
              input.sr-only type="radio" name="lesson_type_mode" value="individual" checked="checked" data-lesson-types-target="modeRadio" data-action="change->lesson-types#onModeChange"
              span.lt-participation__icon aria-hidden="true"
                = icon_tag 'user', size: 17
              span.lt-participation__copy
                strong = t('app.lesson_types.participation_one')
                span = t('app.lesson_types.participation_one_hint')
            label.lt-participation__card
              input.sr-only type="radio" name="lesson_type_mode" value="group" data-lesson-types-target="modeRadio" data-action="change->lesson-types#onModeChange"
              span.lt-participation__icon aria-hidden="true"
                = icon_tag 'users-group', size: 17
              span.lt-participation__copy
                strong = t('app.lesson_types.participation_many')
                span = t('app.lesson_types.participation_many_hint')
          p.lt-field-hint hidden="hidden" data-lesson-types-target="participationHint" = t('app.lesson_types.participation_changed')
        label.lt-field
          span
            = t('app.lesson_types.duration')
            abbr.lt-req *
          .lt-duration
            input type="number" min="1" step="1" list="lesson-type-durations" data-lesson-types-target="duration" aria-label=t('app.lesson_types.duration')
            span.lt-duration__suffix = t('app.lesson_types.min')
            datalist#lesson-type-durations
              - [30, 45, 60, 90, 120].each do |minutes|
                option value=minutes
          p.lt-field-error hidden="hidden" data-lesson-types-target="durationError"
        label.lt-field
          span = t('app.lesson_types.description')
          textarea rows="3" placeholder=t('app.lesson_types.description_optional_placeholder') data-lesson-types-target="description"
        label.lt-check
          input type="checkbox" checked="checked" data-lesson-types-target="active"
          span = t('app.lesson_types.active_label')
      .danlio-modal__foot
        a.danlio-modal__btn.danlio-modal__btn--secondary href=close_path data-turbo="true" data-turbo-frame="lesson_type_dialog" = t('app.common.cancel')
        button.danlio-modal__btn.danlio-modal__btn--primary type="submit" data-lesson-types-target="dialogSubmit" = t('app.lesson_types.add')
