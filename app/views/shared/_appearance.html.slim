            span.appearance-menu__swatch data-appearance-target="chartOptionSwatch" data-chart=chart
            span.appearance-menu__option-label = t("app.appearance.charts.#{chart}")
            = icon_tag 'check', size: 16

    .appearance-menu__item-wrap
      button.appearance-menu__item type="button" aria-haspopup="listbox" aria-expanded="false" data-appearance-target="headingTrigger" data-action="appearance#toggleKind" data-appearance-kind-param="heading"
        span.appearance-menu__copy
          span.appearance-menu__label = t('app.appearance.heading')
          span.appearance-menu__value data-appearance-target="headingValue" Inherit
        span.appearance-menu__aa aria-hidden="true" Aa
      .appearance-menu__panel hidden="hidden" role="listbox" data-appearance-target="headingPanel"
        = render 'shared/appearance_preset_option', kind: 'heading'
        - headings.each do |heading|
          button.appearance-menu__option type="button" role="option" data-appearance-kind="heading" data-value=heading data-action="appearance#chooseKind" data-appearance-kind-param="heading"
            span.appearance-menu__option-label = t("app.appearance.fonts.#{heading}")
            = icon_tag 'check', size: 16

    .appearance-menu__item-wrap
      button.appearance-menu__item type="button" aria-haspopup="listbox" aria-expanded="false" data-appearance-target="fontTrigger" data-action="appearance#toggleKind" data-appearance-kind-param="font"
        span.appearance-menu__copy
          span.appearance-menu__label = t('app.appearance.font')
          span.appearance-menu__value data-appearance-target="fontValue" Inter
        span.appearance-menu__aa aria-hidden="true" Aa
      .appearance-menu__panel hidden="hidden" role="listbox" data-appearance-target="fontPanel"
        = render 'shared/appearance_preset_option', kind: 'font'
        - fonts.each do |font|
          button.appearance-menu__option type="button" role="option" data-appearance-kind="font" data-value=font data-action="appearance#chooseKind" data-appearance-kind-param="font"
            span.appearance-menu__option-label = t("app.appearance.fonts.#{font}")
            = icon_tag 'check', size: 16

    .appearance-menu__item-wrap
      button.appearance-menu__item type="button" aria-haspopup="listbox" aria-expanded="false" data-appearance-target="radiusTrigger" data-action="appearance#toggleKind" data-appearance-kind-param="radius"
        span.appearance-menu__copy
          span.appearance-menu__label = t('app.appearance.radius')
          span.appearance-menu__value data-appearance-target="radiusValue" Default
        span.appearance-menu__trailing
          span.appearance-menu__glyph aria-hidden="true" data-appearance-target="radiusGlyph"
      .appearance-menu__panel hidden="hidden" role="listbox" data-appearance-target="radiusPanel"
        = render 'shared/appearance_preset_option', kind: 'radius'
        - radii.each do |radius|
          button.appearance-menu__option type="button" role="option" data-appearance-kind="radius" data-value=radius data-action="appearance#chooseKind" data-appearance-kind-param="radius"
            span.appearance-menu__glyph aria-hidden="true" data-appearance-target="radiusOptionGlyph" data-radius=radius
            span.appearance-menu__option-label = t("app.appearance.radii.#{radius}")
            = icon_tag 'check', size: 16

    .appearance-menu__actions
      button.appearance-menu__reset-default type="button" data-action="appearance#resetDefault"
        = icon_tag 'adjustments', size: 16
        span = t('app.appearance.reset_default')
      button.appearance-menu__random type="button" data-action="appearance#random"
        = icon_tag 'dices', size: 16
        span = t('app.appearance.random')
