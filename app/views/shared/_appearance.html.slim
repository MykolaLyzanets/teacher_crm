- styles = %w[vega nova maia lyra mira luma sera rhea]
- colors = %w[original olive mist taupe mauve stone zinc neutral]
- backgrounds = %w[dark light classic sage sand mist blush forest]
- themes = %w[amber blue cyan emerald fuchsia green indigo lime orange pink purple red rose sky teal violet yellow]
- charts = themes
- fonts = %w[geist inter noto-sans nunito-sans figtree roboto raleway dm-sans public-sans outfit oxanium manrope space-grotesk montserrat ibm-plex-sans source-sans-3 instrument-sans jetbrains-mono geist-mono noto-serif roboto-slab merriweather lora playfair-display eb-garamond instrument-serif]
- headings = %w[inherit] + fonts
- radii = %w[default none small medium large]

.appearance-menu data-controller="appearance"
  span.sr-only data-appearance-preset-label="true" = t('app.appearance.product_default')
  .appearance-menu__stack
    .appearance-menu__item-wrap
      button.appearance-menu__item type="button" aria-haspopup="listbox" aria-expanded="false" data-appearance-target="styleTrigger" data-action="appearance#toggleKind" data-appearance-kind-param="style"
        span.appearance-menu__copy
          span.appearance-menu__label = t('app.appearance.style')
          span.appearance-menu__value data-appearance-target="styleValue" Nova
        span.appearance-menu__trailing
          span.appearance-menu__glyph aria-hidden="true" data-appearance-target="styleGlyph"
      .appearance-menu__panel hidden="hidden" role="listbox" data-appearance-target="stylePanel"
        = render 'shared/appearance_preset_option', kind: 'style'
        - styles.each do |style|
          button.appearance-menu__option type="button" role="option" data-appearance-kind="style" data-value=style data-action="appearance#chooseKind" data-appearance-kind-param="style"
            span.appearance-menu__glyph aria-hidden="true" data-appearance-target="styleOptionGlyph" data-style=style
            span.appearance-menu__option-label = t("app.appearance.styles.#{style}")
            = icon_tag 'check', size: 16

    .appearance-menu__item-wrap
      button.appearance-menu__item type="button" aria-haspopup="listbox" aria-expanded="false" data-appearance-target="colorTrigger" data-action="appearance#toggleKind" data-appearance-kind-param="color"
        span.appearance-menu__copy
          span.appearance-menu__label = t('app.appearance.base_color')
          span.appearance-menu__value data-appearance-target="colorValue" Neutral
        span.appearance-menu__swatch data-appearance-target="colorSwatch"
      .appearance-menu__panel hidden="hidden" role="listbox" data-appearance-target="colorPanel"
        = render 'shared/appearance_preset_option', kind: 'color'
        - colors.each do |color|
          button.appearance-menu__option type="button" role="option" data-appearance-kind="color" data-value=color data-action="appearance#chooseKind" data-appearance-kind-param="color"
            span.appearance-menu__swatch data-appearance-target="colorOptionSwatch" data-color=color
            span.appearance-menu__option-label = t("app.appearance.colors.#{color}")
            = icon_tag 'check', size: 16

    .appearance-menu__item-wrap
      button.appearance-menu__item type="button" aria-haspopup="listbox" aria-expanded="false" data-appearance-target="backgroundTrigger" data-action="appearance#toggleKind" data-appearance-kind-param="background"
        span.appearance-menu__copy
          span.appearance-menu__label = t('app.appearance.background')
          span.appearance-menu__value data-appearance-target="backgroundValue" Dark
        span.appearance-menu__swatch data-appearance-target="backgroundSwatch"
      .appearance-menu__panel hidden="hidden" role="listbox" data-appearance-target="backgroundPanel"
        = render 'shared/appearance_preset_option', kind: 'background'
        - backgrounds.each do |background|
          button.appearance-menu__option type="button" role="option" data-appearance-kind="background" data-value=background data-action="appearance#chooseKind" data-appearance-kind-param="background"
            span.appearance-menu__swatch data-appearance-target="backgroundOptionSwatch" data-background=background
            span.appearance-menu__option-label = t("app.appearance.backgrounds.#{background}")
            = icon_tag 'check', size: 16

    .appearance-menu__item-wrap
      button.appearance-menu__item type="button" aria-haspopup="listbox" aria-expanded="false" data-appearance-target="themeTrigger" data-action="appearance#toggleKind" data-appearance-kind-param="theme"
        span.appearance-menu__copy
          span.appearance-menu__label = t('app.appearance.theme')
          span.appearance-menu__value data-appearance-target="themeValue" Blue
        span.appearance-menu__swatch data-appearance-target="themeSwatch"
      .appearance-menu__panel hidden="hidden" role="listbox" data-appearance-target="themePanel"
        = render 'shared/appearance_preset_option', kind: 'theme'
        - themes.each do |theme|
          button.appearance-menu__option type="button" role="option" data-appearance-kind="theme" data-value=theme data-action="appearance#chooseKind" data-appearance-kind-param="theme"
            span.appearance-menu__swatch data-appearance-target="themeOptionSwatch" data-theme=theme
            span.appearance-menu__option-label = t("app.appearance.themes.#{theme}")
            = icon_tag 'check', size: 16

    .appearance-menu__item-wrap
      button.appearance-menu__item type="button" aria-haspopup="listbox" aria-expanded="false" data-appearance-target="chartTrigger" data-action="appearance#toggleKind" data-appearance-kind-param="chart"
        span.appearance-menu__copy
          span.appearance-menu__label = t('app.appearance.chart_color')
          span.appearance-menu__value data-appearance-target="chartValue" Blue
        span.appearance-menu__swatch data-appearance-target="chartSwatch"
      .appearance-menu__panel hidden="hidden" role="listbox" data-appearance-target="chartPanel"
        = render 'shared/appearance_preset_option', kind: 'chart'
        - charts.each do |chart|
