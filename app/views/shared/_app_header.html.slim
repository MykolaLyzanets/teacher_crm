header.app-header
  .app-header__inner
    .app-header__start
      button.app-header__menu type="button" aria-label=t('app.header.open_nav') data-action="app-shell#open"
        = icon_tag 'menu', size: 20
      .app-header__mobile-brand
        = link_to root_path, aria: { label: t('app.nav.home') } do
          = image_tag 'brand/danlio-logo.svg', alt: 'danlio', height: 30
      .app-header__search
        = icon_tag 'search', size: 18
        input type="search" placeholder=t('app.header.search_placeholder') aria-label=t('app.header.search')

    .app-header__end
      = render 'layouts/lang_switch'
      .app-header__bell data-controller="notifications" data-notifications-target="root"
        button.app-header__icon-btn type="button" aria-label=t('app.header.notifications') aria-expanded="false" data-notifications-target="button" data-action="notifications#toggle"
          = icon_tag 'bell', size: 20
          - if unread_staff_count.positive?
            span.app-header__badge = unread_staff_count > 9 ? '9+' : unread_staff_count
        .app-header__menu-panel hidden="hidden" data-notifications-target="panel"
          p.app-header__menu-title = t('app.header.notifications')
          - items = staff_notifications
          - if items.blank?
            p.app-header__menu-empty = t('app.header.notifications_empty')
          - else
            ul
              - items.first(20).each do |item|
                li class=("is-unread" unless item[:read])
                  p = item[:title]
                  span = item[:body]
      .app-header__profile data-controller="profile-menu"
        button.app-header__user type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="staff-profile-menu" data-profile-menu-target="button" data-action="profile-menu#toggle"
          span.app-header__avatar = current_user_initials
          span.app-header__user-meta
            span.app-header__user-name = current_user_display_name
            span.app-header__user-role = current_user_role_label
        .app-header__profile-panel hidden="hidden" id="staff-profile-menu" role="menu" aria-label=t('app.header.profile_menu') data-profile-menu-target="panel"
          = link_to profile_path, role: 'menuitem', data: { action: 'profile-menu#close' } do
            = icon_tag 'user', size: 20
            span = t('app.nav.my_profile')
          = link_to settings_path, role: 'menuitem', data: { action: 'profile-menu#close' } do
            = icon_tag 'settings', size: 20
            span = t('app.nav.settings')
          = button_to destroy_user_session_path, method: :delete, form: { class: 'app-header__logout-form', data: { turbo: false } }, class: 'app-header__logout', role: 'menuitem' do
            = icon_tag 'logout', size: 20
            span = t('app.nav.log_out')
