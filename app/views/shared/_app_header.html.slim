header.app-header
  .app-header__inner
    .app-header__start
      button.app-header__menu type="button" aria-label=t('app.header.open_nav') data-action="app-shell#open"
        = icon_tag 'menu', size: 20
      .app-header__mobile-brand
        = link_to root_path, aria: { label: t('app.nav.home') } do
          = image_tag 'brand/danlio-logo.svg', alt: 'danlio', height: 30
      .app-header__search
        = icon_tag 'search', size: 18
        input type="search" placeholder=t('app.header.search_placeholder') aria-label=t('app.header.search')

    .app-header__end
      = render 'layouts/lang_switch'
      button.app-header__icon-btn type="button" aria-label=t('app.header.notifications')
        = icon_tag 'bell', size: 20
      button.app-header__user type="button"
        span.app-header__avatar AT
        span.app-header__user-meta
          span.app-header__user-name Ava Thompson
          span.app-header__user-role = t('app.header.teacher_role')
