- content_for :title, "#{t('sessions.title')} | danlio"

.auth-intro
  h1 = t('sessions.heading')
  p = t('sessions.description')

= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'auth-fields', novalidate: true }) do |f|
  = render 'users/shared/error_messages'
  .auth-field
    = f.label :email, t('sessions.email')
    .auth-input
      = icon_tag 'mail', size: 20
      = f.email_field :email, autofocus: true, autocomplete: 'email', required: true, placeholder: t('sessions.email_placeholder')
  .auth-field
    = f.label :password, t('sessions.password')
    .auth-input
      = icon_tag 'lock', size: 20
      = f.password_field :password, autocomplete: 'current-password', required: true, placeholder: t('sessions.password_placeholder'), data: { auth_password: true }
      button.auth-eye type="button" data-auth-toggle-password="" aria-label=t('sessions.show_password')
        = icon_tag 'eye', size: 20, data: { auth_eye: 'show' }
        = icon_tag 'eye-off', size: 20, data: { auth_eye: 'hide' }, style: 'display:none'
  .auth-row
    - if devise_mapping.rememberable?
      .auth-check
        = f.check_box :remember_me, checked: true
        = f.label :remember_me, t('sessions.remember_me')
    = link_to t('sessions.forgot'), new_password_path(resource_name), class: 'auth-forgot'
  = f.submit t('sessions.submit'), class: 'auth-submit'
  .auth-divider
    span
    p = t('sessions.or')
    span
  = render 'users/shared/social_buttons'

p.auth-switch
  = t('sessions.no_account')
  =< link_to t('sessions.create_account'), new_user_registration_path
.auth-note
  = icon_tag 'shield', size: 20
  = t('auth.security')
