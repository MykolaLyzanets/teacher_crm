- if @teacher.blank?
  - content_for :title, "#{t('app.teachers.not_found_title')} | danlio"
  .teachers-page
    .teachers-page__missing
      .teachers-page__empty-icon
        = icon_tag 'teachers', size: 24
      h1 = t('app.teachers.not_found_title')
      p = t('app.teachers.not_found_text')
      = link_to t('app.teachers.back'), teachers_path, class: 'teachers-page__primary-btn'
- else
  - teacher = @teacher
  - name = teacher_display_name(teacher)
  - display_status = teacher[:displayStatus].presence || teacher[:status].to_s
  - content_for :title, "#{name} | danlio"

  .teachers-page.teachers-page--profile data-controller="teachers" data-teachers-i18n-value=app_i18n_json('app.teachers', 'app.common', 'app.statuses') data-teachers-name-value=name data-teachers-teacher-id-value=teacher[:id] data-teachers-absence-dialog-url-value=teacher_absence_dialog_path(teacher) data-teachers-affected-lessons-url-value=teacher_affected_lessons_url_template(teacher) data-teachers-manage-absence-value=params[:manage_absence] data-teachers-archive-lessons-dialog-url-value=teacher_archive_lessons_dialog_path(teacher) data-teachers-manage-archive-value=params[:manage_archive]
    nav.teachers-page__breadcrumb aria-label="Breadcrumb"
      = link_to t('app.teachers.title'), teachers_path
      = icon_tag 'chevron-right', size: 16
      span = name

    section.teachers-page__hero.teachers-page__card
      .teachers-page__hero-main
        span.teachers-page__avatar.teachers-page__avatar--lg
          - if teacher[:photo].present?
            img.teachers-page__avatar-img alt="" src=teacher[:photo]
          - else
            = teacher_initials(teacher)
          span.teachers-page__color style="background-color: #{teacher_calendar_color(teacher[:calendarColor])}"
        div
          .teachers-page__hero-title
            h1 = name
            - if display_status != 'absent'
              = status_badge teacher_status_label(display_status), tone: teacher_status_tone(display_status)
          - if display_status == 'absent' && teacher[:currentAbsence].present?
            = render 'teachers/absence_status', reason: teacher[:absenceReason], range: teacher_absence_range_from_catalog(teacher[:currentAbsence]), variant: :banner
          p.teachers-page__hero-sub
            = [teacher[:jobTitle], teacher_role_label(teacher[:workspaceRole])].compact_blank.join(' · ')
          .teachers-page__hero-contacts
            - if teacher[:email].present?
              span
                = icon_tag 'mail', size: 18
                = teacher[:email]
            - if teacher[:phone].present?
              span
                = icon_tag 'phone', size: 18
                = teacher[:phone]
      .teachers-page__hero-actions
        - if can_manage_teachers?
          = link_to edit_teacher_path(teacher[:id]), class: 'teachers-page__hero-btn' do
            = icon_tag 'pencil', size: 17
            span = t('app.teachers.edit_teacher')
        - if can_manage_lessons?
          = link_to new_calendar_path(teacher_id: teacher[:id]), class: 'teachers-page__hero-btn', data: calendar_create_turbo_data do
            = icon_tag 'calendar-event', size: 17
            span = t('app.teachers.schedule_lesson')
        - if can_manage_teachers?
          button.teachers-page__hero-btn type="button" data-action="teachers#openAbsence"
            = icon_tag 'calendar-off', size: 17
            span = t('app.teachers.add_absence')

    = render 'teachers/profile_availability', teacher: teacher, week_absences: @teacher_absences_for_week

    = render 'teachers/workspace_access', teacher:, editable: false

    section#lesson-types.teachers-page__card.teachers-page__card--lesson-types data=lesson_types_stimulus_data(mode: 'catalog', teacher_id: teacher[:id])
      = render 'teachers/teaching_section', show_step: true, manager: { show_toast: true }
      = turbo_frame_tag 'offering_dialog'

    - if can_view_finance?
      = render 'teachers/profile_compensation', teacher_record: @teacher_record

    - if can_view_finance? && @teacher_finance
      = render 'teachers/finance_section', teacher_finance: @teacher_finance

    - if teacher[:notes].present?
      section.teachers-page__card
        h2.teachers-page__notes-title
          = icon_tag 'lock', size: 20
          span = t('app.teachers.internal_notes')
        p.teachers-page__notes = teacher[:notes]

    - if @archive_lessons_count.to_i.positive?
      section.teachers-page__card.teachers-page__card--archive-lessons
        .teachers-page__section-head
          div
            h2 = t('app.teachers.archive_lessons_title')
            p.teachers-page__section-sub = t('app.teachers.archive_lessons_profile_sub', count: @archive_lessons_count)
          button.teachers-page__hero-btn type="button" data-action="teachers#openArchiveLessons"
            = icon_tag 'calendar-event', size: 17
            span = t('app.teachers.archive_manage_lessons')
    - if can_manage_teachers?
      section.teachers-page__card data-teachers-target="absenceSection"
        h2 = t('app.teachers.absence_history')
        - if @teacher_absences.any?
          ul.teachers-page__assigned.teachers-page__absence-list
            - @teacher_absences.each do |absence|
              = render 'teachers/absence_row', absence: absence, teacher: teacher, manage_lessons: @absence_manageable_ids.include?(absence.id)
        - else
          p.teachers-page__meta = t('app.teachers.no_absences')

    section.teachers-page__card
      .teachers-page__section-head
        div
          h2 = t('app.teachers.assigned_students')
          p.teachers-page__section-sub data-teachers-target="assignedCount"
            - count = @assigned_students.size
            = count == 1 ? t('app.teachers.assigned_count_one') : t('app.teachers.assigned_count', count: count)
        = link_to teacher_assign_dialog_path(teacher), class: 'teachers-page__primary-btn', data: teacher_dialog_turbo_data('assign_dialog') do
          = icon_tag 'user-plus', size: 16
          span = t('app.teachers.assign_students')

      p.teachers-page__toast hidden="hidden" role="status" data-teachers-target="toast"

      .teachers-page__assigned-search
        = icon_tag 'search', size: 18
        input type="search" placeholder=t('app.teachers.search_assigned') aria-label=t('app.teachers.search_assigned') data-teachers-target="assignedSearch" data-action="input->teachers#filterAssigned"

      .teachers-page__empty.teachers-page__empty--compact data-teachers-target="assignedEmpty" hidden=(@assigned_students.any? ? true : nil)
        .teachers-page__empty-icon
          = icon_tag 'students', size: 24
        h3 = t('app.teachers.no_students')
        p = t('app.teachers.no_students_text')

      ul.teachers-page__assigned data-teachers-target="assignedList" hidden=(@assigned_students.empty? ? true : nil)
        - @assigned_students.each do |student|
          - student = student.with_indifferent_access
          - student_name = [student[:preferredName].presence || student[:firstName], student[:lastName]].compact_blank.join(' ')
          li data-teachers-target="assignedRow" data-id=student[:id] data-search=student_name.downcase data-subjects=Array(student[:subjects]).join(', ') data-status=student[:status] data-path=student_path(student[:id])
            .teachers-page__assigned-main
              span.teachers-page__avatar.teachers-page__avatar--sm = student_name.split.map { |p| p[0] }.first(2).join.upcase
              div
                = link_to student_name, student_path(student[:id]), class: 'teachers-page__name'
                p.teachers-page__meta = Array(student[:subjects]).first(2).join(', ').presence || student_status_label(student[:status])
            .teachers-page__assigned-actions
              = status_badge student_status_label(student[:status]), tone: student_status_tone(student[:status])
              = link_to teacher_unassign_dialog_path(teacher, student), class: 'teachers-page__danger-btn', aria: { label: t('app.teachers.remove_for', name: student_name) }, data: teacher_dialog_turbo_data('unassign_dialog') do
                = icon_tag 'user-x', size: 14
                span = t('app.teachers.remove')

    = turbo_frame_tag 'absence_dialog', data: { teachers_target: 'absenceFrame' }
    = turbo_frame_tag 'archive_lessons_dialog', data: { teachers_target: 'archiveLessonsFrame' }
    = turbo_frame_tag 'affected_lessons_dialog', data: { teachers_target: 'affectedLessonsFrame' }
    = turbo_frame_tag 'assign_dialog'
    = turbo_frame_tag 'unassign_dialog'
    = turbo_frame_tag 'delete_dialog'
    = render 'lesson_types/dialogs'
