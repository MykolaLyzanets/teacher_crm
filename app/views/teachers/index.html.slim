- content_for :title, 'Teachers | danlio'

.teachers-page data-controller="teachers"
  .teachers-page__header
    div
      h1.teachers-page__title Teachers
      p.teachers-page__subtitle Manage teacher profiles, availability and workspace access.
    = link_to new_teacher_path, class: 'teachers-page__primary-btn' do
      = icon_tag 'plus', size: 20
      span Add teacher

  = render 'stats', stats: @stats

  section.teachers-page__panel
    .teachers-page__toolbar
      .teachers-page__search
        = icon_tag 'search', size: 18
        input type="search" placeholder="Search teachers…" aria-label="Search teachers" data-teachers-target="search" data-action="input->teachers#filter"
      .teachers-page__filters
        select aria-label="Filter by status" data-teachers-target="status" data-action="change->teachers#filter"
          option value="" All statuses
          option value="active" Active
          option value="invited" Invited
          option value="on_leave" On leave
          option value="inactive" Inactive
        select aria-label="Filter by student assignment" data-teachers-target="assignment" data-action="change->teachers#filter"
          option value="all" All assignments
          option value="assigned" With students
        span.teachers-page__chip.teachers-page__chip--hidden data-teachers-target="newChip" Created this month

    .teachers-page__empty.teachers-page__empty--hidden data-teachers-target="empty"
      .teachers-page__empty-icon
        = icon_tag 'user', size: 24
      h2 data-teachers-target="emptyTitle" No teachers match your filters
      p data-teachers-target="emptyText" Try a different search or clear the active filters.
      button.teachers-page__secondary-btn type="button" data-action="teachers#clearFilters" data-teachers-target="clearBtn" Clear filters
      = link_to new_teacher_path, class: 'teachers-page__primary-btn teachers-page__empty-add teachers-page__empty-add--hidden', data: { teachers_target: 'addBtn' } do
        = icon_tag 'plus', size: 20
        span Add teacher

    .teachers-page__table data-teachers-target="table"
      .teachers-page__table-head
        span Teacher
        span Contact
        span Role
        span Status
        span.teachers-page__actions-head Actions
      ul.teachers-page__list
        - @teachers.each do |teacher|
          = render 'teacher_row', teacher: teacher, students: @students
