- content_for :title, "#{t('app.teachers.title')} | danlio"

.teachers-page data-controller="teachers" data-teachers-i18n-value=app_i18n_json('app.teachers', 'app.common')
  p.teachers-page__toast hidden="hidden" role="status" data-teachers-target="toast"
  .teachers-page__header
    div
      h1.teachers-page__title = t('app.teachers.title')
      p.teachers-page__subtitle = t('app.teachers.subtitle')
    = link_to new_teacher_path, class: 'teachers-page__primary-btn' do
      = icon_tag 'plus', size: 20
      span = t('app.teachers.add')

  = render 'stats', stats: @stats

  section.teachers-page__panel
    .teachers-page__toolbar
      .teachers-page__toolbar-row
        .teachers-page__search
          = icon_tag 'search', size: 18
          input type="search" placeholder=t('app.teachers.search_placeholder') aria-label=t('app.teachers.search_placeholder') data-teachers-target="search" data-action="input->teachers#filter"
        .teachers-page__filters
          select aria-label=t('app.teachers.filter_status') data-teachers-target="status" data-action="change->teachers#filter"
            option value="" = t('app.teachers.all_statuses')
            - TeachersHelper::TEACHER_FILTER_STATUSES.each do |value|
              option value=value = t("app.statuses.#{value}")
          select aria-label=t('app.teachers.filter_assignment') data-teachers-target="assignment" data-action="change->teachers#filter"
            option value="all" = t('app.teachers.all_assignments')
            option value="assigned" = t('app.teachers.with_students')
          span.teachers-page__chip.teachers-page__chip--hidden data-teachers-target="newChip" = t('app.teachers.created_this_month')

    .teachers-page__empty.teachers-page__empty--hidden data-teachers-target="empty"
      .teachers-page__empty-icon
        = icon_tag 'users-group', size: 24
      h2 data-teachers-target="emptyTitle" = t('app.teachers.empty_filtered_title')
      p data-teachers-target="emptyText" = t('app.teachers.empty_filtered_text')
      button.teachers-page__secondary-btn type="button" data-action="teachers#clearFilters" data-teachers-target="clearBtn" = t('app.common.clear_filters')
      = link_to new_teacher_path, class: 'teachers-page__primary-btn teachers-page__empty-add teachers-page__empty-add--hidden', data: { teachers_target: 'addBtn' } do
        = icon_tag 'plus', size: 20
        span = t('app.teachers.add')

    .teachers-page__table data-teachers-target="table"
      .teachers-page__table-head
        span = t('app.common.teacher')
        span = t('app.students.col_contact')
        span = t('app.teachers.col_role')
        span = t('app.students.col_status')
        span.teachers-page__actions-head = t('app.students.col_actions')
      ul.teachers-page__list
        - @teachers.each do |teacher|
          = render 'teacher_row', teacher: teacher, students: @students

  = turbo_frame_tag 'delete_dialog'
  = turbo_frame_tag 'archive_lessons_dialog'
