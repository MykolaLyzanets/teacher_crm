- stats = stats.with_indifferent_access

.teachers-page__stats data-teachers-target="stats"
  button.teachers-page__stat type="button" data-filter="all" data-action="teachers#statsFilter" data-teachers-target="stat" aria-pressed="true" aria-label=t('app.teachers.stats_total')
    span.teachers-page__stat-icon
      = icon_tag 'users-group', size: 26
    span.teachers-page__stat-body
      span.teachers-page__stat-label = t('app.teachers.stats_total')
      span.teachers-page__stat-value = stats[:totalTeachers]
      span.teachers-page__stat-support = t('app.teachers.stats_total_support')

  button.teachers-page__stat type="button" data-filter="active" data-action="teachers#statsFilter" data-teachers-target="stat" aria-pressed="false" aria-label=t('app.teachers.stats_active')
    span.teachers-page__stat-icon
      = icon_tag 'user-check', size: 26
    span.teachers-page__stat-body
      span.teachers-page__stat-label = t('app.teachers.stats_active')
      span.teachers-page__stat-value = stats[:activeTeachers]
      span.teachers-page__stat-support = teacher_stats_supporting(stats, :active)

  button.teachers-page__stat type="button" data-filter="withStudents" data-action="teachers#statsFilter" data-teachers-target="stat" aria-pressed="false" aria-label=t('app.teachers.stats_with_students')
    span.teachers-page__stat-icon
      = icon_tag 'grad', size: 26
    span.teachers-page__stat-body
      span.teachers-page__stat-label = t('app.teachers.stats_with_students')
      span.teachers-page__stat-value = stats[:teachersWithStudents]
      span.teachers-page__stat-support = teacher_stats_supporting(stats, :with_students)

  = link_to calendar_path, class: 'teachers-page__stat teachers-page__stat--link', aria: { label: t('app.teachers.stats_lessons') } do
    span.teachers-page__stat-icon
      = icon_tag 'calendar', size: 26
    span.teachers-page__stat-body
      span.teachers-page__stat-label = t('app.teachers.stats_lessons')
      span.teachers-page__stat-value = stats[:lessonsThisMonth]
      span.teachers-page__stat-support = teacher_stats_supporting(stats, :lessons)

  button.teachers-page__stat type="button" data-filter="newThisMonth" data-action="teachers#statsFilter" data-teachers-target="stat" aria-pressed="false" aria-label=t('app.teachers.stats_new')
    span.teachers-page__stat-icon
      = icon_tag 'chart-pie', size: 26
    span.teachers-page__stat-body
      span.teachers-page__stat-label = t('app.teachers.stats_new')
      span.teachers-page__stat-value = stats[:newThisMonth]
      span.teachers-page__stat-support = teacher_stats_supporting(stats, :new)
