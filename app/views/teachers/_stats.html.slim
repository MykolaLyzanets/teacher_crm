- stats = stats.with_indifferent_access

.teachers-page__stats data-teachers-target="stats"
  button.teachers-page__stat type="button" data-filter="all" data-action="teachers#statsFilter" data-teachers-target="stat" aria-pressed="true" aria-label="Show all teachers"
    span.teachers-page__stat-icon
      = icon_tag 'teachers', size: 26
    span.teachers-page__stat-body
      span.teachers-page__stat-label Total Teachers
      span.teachers-page__stat-value = stats[:totalTeachers]
      span.teachers-page__stat-support All teachers

  button.teachers-page__stat type="button" data-filter="active" data-action="teachers#statsFilter" data-teachers-target="stat" aria-pressed="false" aria-label="Show active teachers"
    span.teachers-page__stat-icon
      = icon_tag 'check-circle', size: 26
    span.teachers-page__stat-body
      span.teachers-page__stat-label Active Teachers
      span.teachers-page__stat-value = stats[:activeTeachers]
      span.teachers-page__stat-support = teacher_stats_supporting(stats, :active)

  button.teachers-page__stat type="button" data-filter="withStudents" data-action="teachers#statsFilter" data-teachers-target="stat" aria-pressed="false" aria-label="Show teachers with assigned students"
    span.teachers-page__stat-icon
      = icon_tag 'school', size: 26
    span.teachers-page__stat-body
      span.teachers-page__stat-label With Students
      span.teachers-page__stat-value = stats[:teachersWithStudents]
      span.teachers-page__stat-support = teacher_stats_supporting(stats, :with_students)

  = link_to calendar_path, class: 'teachers-page__stat teachers-page__stat--link', aria: { label: 'Open lessons for this month' } do
    span.teachers-page__stat-icon
      = icon_tag 'calendar', size: 26
    span.teachers-page__stat-body
      span.teachers-page__stat-label Lessons This Month
      span.teachers-page__stat-value = stats[:lessonsThisMonth]
      span.teachers-page__stat-support = teacher_stats_supporting(stats, :lessons)

  button.teachers-page__stat type="button" data-filter="newThisMonth" data-action="teachers#statsFilter" data-teachers-target="stat" aria-pressed="false" aria-label="Show teachers added this month"
    span.teachers-page__stat-icon
      = icon_tag 'chart-bars', size: 26
    span.teachers-page__stat-body
      span.teachers-page__stat-label New This Month
      span.teachers-page__stat-value = stats[:newThisMonth]
      span.teachers-page__stat-support = teacher_stats_supporting(stats, :new)
