- editing = @editing
- teacher = (@teacher || {}).with_indifferent_access
- working_days = Array(teacher[:workingDays])
- working_days = %w[Monday Tuesday Wednesday Thursday Friday] if working_days.blank? && !editing
- duration_preset = teacher.present? ? teacher_duration_preset(teacher) : '60'
- form_url = editing ? teacher_path(teacher[:id]) : teachers_path
- form_method = editing ? :patch : :post
- content_for :title, "#{editing ? t('app.teachers.edit_title') : t('app.teachers.create_title')} | danlio"

.teachers-page.teachers-page--form data-controller="teachers lesson-types" data-teachers-i18n-value=app_i18n_json('app.teachers', 'app.common') data-lesson-types-mode-value="teacher" data-lesson-types-seed-value=lesson_types_seed_json data-lesson-types-i18n-value=app_i18n_json('app.lesson_types') data-lesson-types-teacher-id-value=teacher[:id].to_s data-lesson-types-teacher-email-value=teacher[:email].to_s data-lesson-types-require-active-value=(teacher[:status].to_s != 'inactive') data-lesson-types-default-currency-value="UAH"
  p.settings-page__toast hidden="hidden" role="status" data-lesson-types-target="toast"
  nav.teachers-page__breadcrumb aria-label="Breadcrumb"
    = link_to t('app.teachers.title'), teachers_path
    = icon_tag 'chevron-right', size: 16
    span = editing ? t('app.teachers.edit_title') : t('app.teachers.create_title')

  .teachers-page__form-header
    .teachers-page__form-intro
      .teachers-page__empty-icon
        = icon_tag 'user', size: 24
      div
        h1.teachers-page__title = editing ? t('app.teachers.edit_title') : t('app.teachers.create_title')
        p.teachers-page__subtitle = editing ? t('app.teachers.edit_subtitle') : t('app.teachers.create_subtitle')
    .teachers-page__form-actions.teachers-page__form-actions--top
      = link_to t('app.common.cancel'), teachers_path, class: 'teachers-page__secondary-btn'
      button.teachers-page__primary-btn type="submit" form="teacher-form" = editing ? t('app.teachers.save_teacher') : t('app.teachers.create_teacher')

  = form_with url: form_url, method: form_method, html: { id: 'teacher-form', class: 'teachers-page__form', novalidate: true, data: { action: 'submit->teachers#validateHours submit->lesson-types#validateAccess' } } do
    section.teachers-page__card
      h2 = t('app.teachers.basic_info')
      p.teachers-page__section-sub = t('app.teachers.basic_info_sub')
      .teachers-page__photo
        .teachers-page__photo-avatar
          span data-teachers-target="initialsPreview" = teacher_initials(teacher)
          img.teachers-page__photo-img alt="" hidden="hidden" data-teachers-target="photoImage"
          span.teachers-page__photo-badge
            = icon_tag 'user', size: 16
        .teachers-page__photo-copy
          p.teachers-page__photo-title = t('app.teachers.photo')
          p.teachers-page__photo-hint = t('app.teachers.photo_hint')
          .teachers-page__photo-actions
            button.teachers-page__olive-btn type="button" data-action="teachers#pickPhoto" data-teachers-target="photoPick"
              = icon_tag 'file', size: 18
              span = t('app.teachers.choose_file')
            button.teachers-page__secondary-btn type="button" hidden="hidden" data-action="teachers#removePhoto" data-teachers-target="photoRemove"
              = icon_tag 'x', size: 18
              span = t('app.teachers.remove_photo')
          p.teachers-page__field-error hidden="hidden" data-teachers-target="photoError"
          input.sr-only type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" data-teachers-target="photoInput" data-action="change->teachers#previewPhoto"
      .teachers-page__fields
        label.teachers-page__field
          span = t('app.teachers.first_name') + ' *'
          input type="text" name="first_name" required=true autocomplete="given-name" placeholder="Olivia" value=teacher[:firstName] data-teachers-target="firstName" data-action="input->teachers#updateInitials"
        label.teachers-page__field
          span = t('app.teachers.last_name') + ' *'
          input type="text" name="last_name" required=true autocomplete="family-name" placeholder="Anderson" value=teacher[:lastName] data-teachers-target="lastName" data-action="input->teachers#updateInitials"
        label.teachers-page__field
          span = t('app.teachers.display_name')
          input type="text" name="display_name" placeholder=t('app.teachers.display_placeholder') value=teacher[:displayName] data-teachers-target="displayName" data-action="input->teachers#updateInitials"
        label.teachers-page__field
          span = t('app.teachers.job_title')
          input type="text" name="job_title" placeholder=t('app.teachers.job_placeholder') value=teacher[:jobTitle] list="teacher-job-title-examples"
          datalist#teacher-job-title-examples
            option value="English teacher"
            option value="Mathematics tutor"
            option value="Senior teacher"
            option value="Academic coordinator"
        label.teachers-page__field
          span = t('app.teachers.teacher_status') + ' *'
          select name="status" required=true
            option value="active" selected=(teacher[:status].to_s == 'active' || teacher[:status].blank?) = t('app.statuses.active')
            option value="invited" selected=(teacher[:status].to_s == 'invited') = t('app.statuses.invited')
            option value="on_leave" selected=(teacher[:status].to_s == 'on_leave') = t('app.statuses.on_leave')
            option value="inactive" selected=(teacher[:status].to_s == 'inactive') = t('app.statuses.inactive')

    section.teachers-page__card
      h2 = t('app.teachers.contact')
      p.teachers-page__section-sub = t('app.teachers.contact_sub')
      .teachers-page__fields
        label.teachers-page__field
          span = t('app.teachers.email')
          .teachers-page__input-icon
            = icon_tag 'mail', size: 18
            input type="email" name="email" autocomplete="email" placeholder="olivia@example.com" value=teacher[:email]
        label.teachers-page__field
          span = t('app.teachers.phone')
          .teachers-page__input-icon
            = icon_tag 'message', size: 18
            input type="tel" name="phone" autocomplete="tel" placeholder="+1 555 0100" value=teacher[:phone]
        label.teachers-page__field
          span = t('app.teachers.preferred_contact')
          select name="preferred_contact_method"
            option value="email" selected=(teacher[:preferredContactMethod].to_s == 'email' || teacher[:preferredContactMethod].blank?) = t('app.teachers.email')
            option value="phone" selected=(teacher[:preferredContactMethod].to_s == 'phone') = t('app.teachers.phone')
            option value="either" selected=(teacher[:preferredContactMethod].to_s == 'either') = t('app.teachers.contact_either')
        label.teachers-page__field
          span = t('app.teachers.timezone')
          select name="timezone"
            - TeachersHelper::TIMEZONES.each do |tz|
              option value=tz selected=(tz == (teacher[:timezone].presence || 'America/New_York')) = tz
        label.teachers-page__field.teachers-page__field--full
          span = t('app.teachers.location')
          input type="text" name="location" placeholder=t('app.teachers.location_placeholder') value=teacher[:location]

    section.teachers-page__card
      h2 = t('app.teachers.teaching')
      p.teachers-page__section-sub = t('app.teachers.teaching_sub')
      .teachers-page__subject-select data-subject-root=""
        p.teachers-page__chips-label = t('app.teachers.subjects')
        p.teachers-page__hint = t('app.teachers.subjects_hint')
        .teachers-page__subject-row
          .teachers-page__subject-list data-teachers-target="subjectList"
            - Array(teacher[:subjects]).each do |subject|
              span.teachers-page__subject-chip
                input type="hidden" name="subjects[]" value=subject
                span = subject
                button type="button" data-action="teachers#removeSubject" aria-label=t('app.teachers.remove_subject') ×
          button.teachers-page__subject-add type="button" data-action="teachers#openSubjectPopover"
            = icon_tag 'plus', size: 16
            span = t('app.teachers.add_subject')
        .teachers-page__subject-popover hidden="hidden" data-teachers-target="subjectPopover"
          input type="text" placeholder=t('app.teachers.subject_placeholder') data-teachers-target="subjectDraft" data-action="keydown.enter->teachers#addSubject"
          button.teachers-page__link-btn type="button" data-action="teachers#addSubject" = t('app.common.add')
          p.teachers-page__field-error hidden="hidden" data-teachers-target="subjectError"
      .teachers-page__lesson-types
        p.teachers-page__chips-label = t('app.teachers.lesson_types')
        p.teachers-page__hint = t('app.teachers.lesson_types_hint')
        p.lt-field-error hidden="hidden" data-lesson-types-target="listError"
        .lt-access-list data-lesson-types-target="accessList"
        button.teachers-page__secondary-btn type="button" data-action="lesson-types#openNew"
          = icon_tag 'plus', size: 16
          span = t('app.lesson_types.add')
      .teachers-page__fields
        .teachers-page__field
          p.teachers-page__chips-label
            = t('app.teachers.experience')
            span.teachers-page__optional = t('app.teachers.optional')
          .teachers-page__price-row
            input type="number" name="experience_years" min="0" step="1" placeholder="5" value=teacher[:experienceYears]
            span.teachers-page__hint = t('app.teachers.years')
        label.teachers-page__field.teachers-page__field--full
          span
            = t('app.teachers.bio')
            span.teachers-page__optional = t('app.teachers.optional')
          textarea name="bio" rows="4" maxlength="600" placeholder=t('app.teachers.bio_placeholder') = teacher[:bio]

    section.teachers-page__card
      h2 = t('app.teachers.availability')
      p.teachers-page__section-sub = t('app.teachers.availability_sub')
      .teachers-page__chips-block
        p.teachers-page__chips-label = t('app.teachers.working_days')
        .teachers-page__chips
          - TeachersHelper::WEEK_DAYS.each do |day|
            label.teachers-page__chip-toggle
              input type="checkbox" name="working_days[]" value=day checked=working_days.include?(day) data-teachers-target="workingDay" data-day=day data-action="change->teachers#toggleWorkingDay"
              span = weekday_short_label(day)
      .teachers-page__hours data-teachers-target="hoursWrap"
        .teachers-page__hours-head
          p.teachers-page__chips-label = t('app.teachers.available_hours')
          button.teachers-page__link-btn type="button" data-action="teachers#copyMonday" data-teachers-target="copyMonday" = t('app.teachers.copy_monday')
        .teachers-page__hours-list
          - TeachersHelper::WEEK_DAYS.each do |day|
            - selected_day = working_days.include?(day)
            .teachers-page__hours-row data-teachers-target="hoursRow" data-day=day hidden=(selected_day ? nil : true)
              span = weekday_short_label(day)
              label.sr-only for="start-#{day}" = "#{day} start"
              input id="start-#{day}" type="time" name="working_hours[#{day}][start]" value=teacher_hour_value(teacher, day, 'start') data-role="start" disabled=(selected_day ? nil : true)
              label.sr-only for="end-#{day}" = "#{day} end"
              input id="end-#{day}" type="time" name="working_hours[#{day}][end]" value=teacher_hour_value(teacher, day, 'end') data-role="end" disabled=(selected_day ? nil : true)
      p.teachers-page__field-error hidden="hidden" data-teachers-target="hoursError"
      .teachers-page__fields
        label.teachers-page__field
          span = t('app.teachers.default_duration')
          input type="hidden" name="default_lesson_duration_minutes" value=(duration_preset == 'custom' ? teacher[:defaultLessonDurationMinutes] : duration_preset) data-teachers-target="durationValue"
          select data-teachers-target="durationPreset" data-action="change->teachers#toggleCustomDuration" name="duration_preset"
            - [30, 45, 60, 90].each do |minutes|
              option value=minutes selected=(duration_preset == minutes.to_s) = t('app.teachers.minutes', count: minutes)
            option value="custom" selected=(duration_preset == 'custom') = t('app.teachers.custom_duration')
        label.teachers-page__field data-teachers-target="customDuration" hidden=(duration_preset == 'custom' ? nil : true)
          span = t('app.teachers.custom_duration_minutes')
          input type="number" name="custom_duration" min="1" step="1" placeholder="75" value=(duration_preset == 'custom' ? teacher[:defaultLessonDurationMinutes] : nil) data-teachers-target="customMinutes" data-action="input->teachers#syncCustomMinutes"
        label.teachers-page__field.teachers-page__field--full
          span = t('app.teachers.lesson_formats')
          .teachers-page__chips
            - [['online', t('app.common.online')], ['in_person', t('app.common.in_person')], ['hybrid', t('app.common.hybrid')]].each do |value, label|
              label.teachers-page__chip-toggle
                input type="checkbox" name="lesson_formats[]" value=value checked=Array(teacher[:lessonFormats].presence || ['online']).include?(value)
                span = label
        fieldset.teachers-page__field.teachers-page__field--full
          legend.teachers-page__chips-label = t('app.teachers.calendar_color')
          p.teachers-page__hint = t('app.teachers.calendar_color_hint')
          input type="hidden" name="calendar_color" value=(teacher[:calendarColor].presence || 'olive') data-teachers-target="calendarColor"
          .teachers-page__color-btns
            - TeachersHelper::CALENDAR_COLORS.each do |id, hex|
              button.teachers-page__color-btn type="button" data-color=id data-action="teachers#setCalendarColor" aria-pressed=(id.to_s == (teacher[:calendarColor].presence || 'olive').to_s) aria-label=teacher_color_label(id)
                span style="background-color: #{hex}"
                = teacher_color_label(id)

    section.teachers-page__card
      h2 = t('app.teachers.internal_notes')
      p.teachers-page__section-sub = t('app.teachers.internal_notes_sub')
      label.teachers-page__field.teachers-page__field--full
        span = t('app.teachers.notes')
        textarea name="notes" rows="4" maxlength="500" placeholder=t('app.teachers.notes_placeholder') data-teachers-target="notes" data-action="input->teachers#updateNotesCount" = teacher[:notes]
      .teachers-page__notes-meta
        p
          = icon_tag 'lock', size: 14
          span = t('app.teachers.notes_visible')
        p data-teachers-target="notesCount" 0/500

    .teachers-page__form-actions
      = link_to t('app.common.cancel'), teachers_path, class: 'teachers-page__secondary-btn'
      button.teachers-page__primary-btn type="submit" = editing ? t('app.teachers.save_teacher') : t('app.teachers.create_teacher')

  = render 'lesson_types/dialogs'
