- editing = @editing
- teacher = (@teacher || {}).with_indifferent_access
- duration_preset = teacher_duration_preset(teacher)
- form_url = editing ? teacher_path(teacher[:id]) : teachers_path
- form_method = editing ? :patch : :post
- cancel_path = editing ? teacher_path(teacher[:id]) : teachers_path
- has_photo = teacher[:photo].present?
- content_for :title, "#{editing ? t('app.teachers.edit_title') : t('app.teachers.create_title')} | danlio"

.teachers-page.teachers-page--form data-controller="teachers" data-teachers-i18n-value=app_i18n_json('app.teachers', 'app.common') data-teachers-editing-value=editing data-teachers-name-value=teacher_display_name(teacher)
  .lt-scope data=lesson_types_stimulus_data(mode: 'teacher_assign', teacher_id: teacher[:id])
    nav.teachers-page__breadcrumb aria-label="Breadcrumb"
      = link_to t('app.teachers.title'), teachers_path
      = icon_tag 'chevron-right', size: 16
      - if editing
        = link_to teacher_display_name(teacher), teacher_path(teacher[:id])
        = icon_tag 'chevron-right', size: 16
      span = editing ? t('app.teachers.edit_title') : t('app.teachers.create_title')

    .teachers-page__form-header
      .teachers-page__form-intro
        .teachers-page__empty-icon
          = icon_tag editing ? 'pencil' : 'user-plus', size: 24
        div
          h1.teachers-page__title = editing ? t('app.teachers.edit_title') : t('app.teachers.create_title')
          p.teachers-page__subtitle = editing ? t('app.teachers.edit_subtitle') : t('app.teachers.create_subtitle')
      .teachers-page__form-actions.teachers-page__form-actions--top
        = link_to t('app.common.cancel'), cancel_path, class: 'teachers-page__secondary-btn', data: { action: 'teachers#confirmLeave' }
        button.teachers-page__primary-btn type="submit" form="teacher-form" data-teachers-target="submitBtn" = editing ? t('app.teachers.save_teacher') : t('app.teachers.create_teacher')

    = form_with url: form_url, method: form_method, multipart: true, html: { id: 'teacher-form', class: 'teachers-page__form', novalidate: true, data: { action: 'submit->teachers#validateSubmit' } } do
      section.teachers-page__card
        h2 = t('app.teachers.basic_info')
        p.teachers-page__section-sub = t('app.teachers.basic_info_sub')
        .teachers-page__photo
          .teachers-page__photo-frame
            .teachers-page__photo-avatar
              span data-teachers-target="initialsPreview" hidden=(has_photo || nil) = teacher_initials(teacher)
              img.teachers-page__photo-img alt="" hidden=(has_photo ? nil : true) data-teachers-target="photoImage" src=teacher[:photo].presence
            span.teachers-page__photo-badge
              = icon_tag 'camera', size: 16
          .teachers-page__photo-copy
            p.teachers-page__photo-title = t('app.teachers.photo')
            p.teachers-page__photo-hint = t('app.teachers.photo_hint')
            .teachers-page__photo-actions
              button.teachers-page__olive-btn type="button" data-action="teachers#pickPhoto" data-teachers-target="photoPick"
                = icon_tag 'upload', size: 18
                span = has_photo ? t('app.teachers.replace_photo') : t('app.teachers.choose_file')
              button.teachers-page__secondary-btn type="button" hidden=(has_photo ? nil : true) data-action="teachers#removePhoto" data-teachers-target="photoRemove"
                = icon_tag 'trash', size: 18
                span = t('app.teachers.remove_photo')
            p.teachers-page__field-error hidden="hidden" data-teachers-target="photoError"
            input type="hidden" name="remove_photo" value="0" data-teachers-target="removePhotoInput"
            input.sr-only type="file" name="photo" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" data-teachers-target="photoInput" data-action="change->teachers#previewPhoto"
        .teachers-page__fields
          label.teachers-page__field
            span
              = t('app.teachers.first_name')
              span.teachers-page__req *
            input type="text" name="first_name" required=true autocomplete="given-name" placeholder="Olivia" value=teacher[:firstName] data-teachers-target="firstName" data-action="input->teachers#updateInitials blur->teachers#markTouched"
            p.teachers-page__field-error hidden="hidden" data-error-for="firstName"
          label.teachers-page__field
            span
              = t('app.teachers.last_name')
              span.teachers-page__req *
            input type="text" name="last_name" required=true autocomplete="family-name" placeholder="Anderson" value=teacher[:lastName] data-teachers-target="lastName" data-action="input->teachers#updateInitials blur->teachers#markTouched"
            p.teachers-page__field-error hidden="hidden" data-error-for="lastName"
          label.teachers-page__field
            span = t('app.teachers.display_name')
            input type="text" name="display_name" placeholder=t('app.teachers.display_placeholder') value=teacher[:displayName] data-teachers-target="displayName" data-action="input->teachers#updateInitials"
            span.teachers-page__hint = t('app.teachers.display_name_hint')
          label.teachers-page__field
            span = t('app.teachers.job_title')
            input type="text" name="job_title" placeholder=t('app.teachers.job_placeholder') value=teacher[:jobTitle] list="teacher-job-title-examples"
            datalist#teacher-job-title-examples
              option value="English teacher"
              option value="Mathematics tutor"
              option value="Senior teacher"
              option value="Academic coordinator"
          label.teachers-page__field
            span
              = t('app.teachers.teacher_status')
              span.teachers-page__req *
            select name="status" required=true data-teachers-target="formStatus" data-action="blur->teachers#markTouched"
              - TeachersHelper::TEACHER_FORM_STATUSES.each do |value|
                option value=value selected=(teacher[:status].to_s == value || (value == 'active' && teacher[:status].blank?)) = t("app.statuses.#{value}")
              - if teacher[:status].to_s == 'archived'
                option value="archived" selected=true = t('app.statuses.archived')
            p.teachers-page__field-error hidden="hidden" data-error-for="status"

      section.teachers-page__card
        h2 = t('app.teachers.contact')
        p.teachers-page__section-sub = t('app.teachers.contact_sub')
        - contact_timezones = (TeachersHelper::TIMEZONES + [TeacherProfile::DEFAULT_TIMEZONE, teacher[:timezone]]).compact.uniq
        .teachers-page__fields
          label.teachers-page__field
            span
              = t('app.teachers.email')
              span.teachers-page__req *
            .teachers-page__input-icon
              = icon_tag 'mail', size: 18
              input type="email" name="email" required=true autocomplete="email" placeholder="olivia@example.com" value=teacher[:email] data-teachers-target="email" data-action="blur->teachers#markTouched"
            p.teachers-page__field-error hidden="hidden" data-error-for="email"
          label.teachers-page__field
            span = t('app.teachers.phone')
            .teachers-page__input-icon
              = icon_tag 'phone', size: 18
              input type="tel" name="phone" autocomplete="tel" placeholder="+1 555 0100" value=teacher[:phone]
          label.teachers-page__field
            span = t('app.teachers.preferred_contact')
            select name="preferred_contact_method"
              option value="email" selected=(teacher[:preferredContactMethod].to_s == 'email' || teacher[:preferredContactMethod].blank?) = t('app.teachers.email_option')
              option value="phone" selected=(teacher[:preferredContactMethod].to_s == 'phone') = t('app.teachers.phone_option')
              option value="either" selected=(teacher[:preferredContactMethod].to_s == 'either') = t('app.teachers.contact_either')
          label.teachers-page__field
            span = t('app.teachers.timezone')
            select name="timezone"
              - contact_timezones.each do |tz|
                option value=tz selected=(tz == (teacher[:timezone].presence || TeacherProfile::DEFAULT_TIMEZONE)) = teacher_timezone_label(tz)
            span.teachers-page__hint = t('app.teachers.timezone_hint')
          label.teachers-page__field.teachers-page__field--full
            span = t('app.teachers.location')
            input type="text" name="location" placeholder=t('app.teachers.location_placeholder') value=teacher[:location]

      input type="hidden" name="lesson_catalog" value=(teacher[:lessonCatalog].presence || '[]') data-lesson-types-target="draftPayload"
      = render 'teachers/teaching_section', show_step: true, assignment_only: true
      = render 'teachers/compensation_section', compensation_setup: teacher[:compensationSetup]

      = render 'teachers/availability_section', teacher:

      section.teachers-page__card
        h2 = t('app.teachers.internal_notes')
        p.teachers-page__section-sub = t('app.teachers.internal_notes_sub')
        label.teachers-page__field.teachers-page__field--full
          span = t('app.teachers.notes')
          textarea name="notes" rows="4" maxlength="500" placeholder=t('app.teachers.notes_placeholder') data-teachers-target="notes" data-action="input->teachers#updateNotesCount blur->teachers#markTouched" = teacher[:notes]
          p.teachers-page__field-error hidden="hidden" data-error-for="notes"
        .teachers-page__notes-meta
          p
            = icon_tag 'lock', size: 14
            span = t('app.teachers.notes_visible')
          p data-teachers-target="notesCount" 0/500

      p.teachers-page__form-alert hidden="hidden" data-teachers-target="formAlert" = editing ? t('app.teachers.fix_fields_save') : t('app.teachers.fix_fields')

      .teachers-page__form-actions.teachers-page__form-actions--sticky
        = link_to t('app.common.cancel'), cancel_path, class: 'teachers-page__secondary-btn', data: { action: 'teachers#confirmLeave' }
        button.teachers-page__primary-btn type="submit" data-teachers-target="submitBtn" = editing ? t('app.teachers.save_teacher') : t('app.teachers.create_teacher')

    = render 'lesson_types/dialogs'
