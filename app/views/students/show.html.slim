- if @student.blank?
  - content_for :title, "#{t('app.students.not_found_title')} | danlio"
  .students-page
    .students-page__missing
      .students-page__empty-icon
        = icon_tag 'students', size: 24
      h1 = t('app.students.not_found_title')
      p = t('app.students.not_found_text')
      = link_to t('app.students.back'), students_path, class: 'students-page__primary-btn'
- else
  - student = @student
  - name = student_display_name(student)
  - lessons = Array(@student_lessons)
  - homework = Array(@student_homework)
  - notes = Array(@student_notes)
  - upcoming = student_upcoming_lessons(lessons)
  - next_lesson = upcoming.first
  - stats = student_profile_stats(lessons:, homework:, progress: @student_progress)
  - activity = student_activity_items(lessons:, homework:, progress: @student_progress, notes:, finance: @finance, include_finance: can_view_finance?)
  - content_for :title, "#{name} | danlio"

  .students-page.students-page--profile data-controller="students" data-students-i18n-value=app_i18n_json('app.students', 'app.common')
    nav.students-page__breadcrumb aria-label="Breadcrumb"
      = link_to t('app.students.title'), students_path
      = icon_tag 'chevron-right', size: 16
      span = name

    = render 'students/profile/header', student: student, name: name
    p.students-page__toast hidden="hidden" role="status" data-students-target="toast"
    = render 'students/profile/stats', stats: stats

    - active_tab = @profile_tab.presence || 'overview'
    .students-page__tabs data-controller="profile-tabs"
      - tabs = student_profile_tab_items
      div role="tablist" aria-label=t('app.students.tabs_aria')
        - tabs.each do |tab|
          - selected = tab[:id] == active_tab
          = link_to student_profile_tab_path(student, tab[:id]), class: "students-page__tab#{' is-active' if selected}", role: 'tab', id: "student-tab-#{tab[:id]}", aria: { controls: "student-panel-#{tab[:id]}", selected: selected }, tabindex: (selected ? 0 : -1), data: { profile_tabs_target: 'tab', tab: tab[:id], action: 'click->profile-tabs#select keydown->profile-tabs#keydown' } do
            = tab[:label]

      .students-page__tab-panel class=(active_tab == 'overview' ? nil : 'is-hidden') role="tabpanel" id="student-panel-overview" aria-labelledby="student-tab-overview" hidden=(active_tab == 'overview' ? nil : true) data-profile-tabs-target="panel" data-tab="overview"
        = render 'students/profile/overview', student: student, upcoming: upcoming, next_lesson: next_lesson, activity: activity, progress: @student_progress, pricing: @pricing, finance: @finance, balance_cents: @balance_cents

      .students-page__tab-panel class=(active_tab == 'lessons' ? nil : 'is-hidden') role="tabpanel" id="student-panel-lessons" aria-labelledby="student-tab-lessons" hidden=(active_tab == 'lessons' ? nil : true) data-profile-tabs-target="panel" data-tab="lessons"
        = render 'students/profile/lessons', student: student, lessons: lessons

      .students-page__tab-panel class=(active_tab == 'homework' ? nil : 'is-hidden') role="tabpanel" id="student-panel-homework" aria-labelledby="student-tab-homework" hidden=(active_tab == 'homework' ? nil : true) data-profile-tabs-target="panel" data-tab="homework"
        = render 'students/profile/homework', homework: homework

      .students-page__tab-panel class=(active_tab == 'progress' ? nil : 'is-hidden') role="tabpanel" id="student-panel-progress" aria-labelledby="student-tab-progress" hidden=(active_tab == 'progress' ? nil : true) data-profile-tabs-target="panel" data-tab="progress"
        = render 'students/profile/progress', progress: @student_progress

      - if can_view_finance?
        .students-page__tab-panel class=(active_tab == 'payments' ? nil : 'is-hidden') role="tabpanel" id="student-panel-payments" aria-labelledby="student-tab-payments" hidden=(active_tab == 'payments' ? nil : true) data-profile-tabs-target="panel" data-tab="payments"
          = render 'students/profile/payments', student: student, finance: @finance, pricing: @pricing, balance_cents: @balance_cents

      .students-page__tab-panel class=(active_tab == 'notes' ? nil : 'is-hidden') role="tabpanel" id="student-panel-notes" aria-labelledby="student-tab-notes" hidden=(active_tab == 'notes' ? nil : true) data-profile-tabs-target="panel" data-tab="notes"
        = render 'students/profile/notes', notes: notes

    - if can_assign_teacher?
      = turbo_frame_tag 'assign_dialog'

      .students-page__dialog hidden="hidden" data-students-target="removeDialog"
        .students-page__dialog-backdrop data-action="click->students#closeRemove"
        .students-page__dialog-card role="dialog" aria-modal="true" aria-labelledby="remove-assignment-title"
          h2#remove-assignment-title = t('app.students.remove_confirm_title')
          p = t('app.students.remove_confirm_text')
          = form_with url: unassign_student_path(student[:id]), method: :delete, html: { hidden: true, data: { students_target: 'unassignForm' } }
          .students-page__dialog-actions
            button.students-page__secondary-btn type="button" data-action="students#closeRemove" = t('app.common.cancel')
            button.students-page__danger-btn type="button" data-action="students#confirmRemove" = t('app.students.remove_assignment')

    = turbo_frame_tag 'delete_dialog'
