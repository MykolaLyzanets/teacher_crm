section.students-page__hero
  .students-page__hero-main
    .students-page__hero-identity
      = student_avatar(student, size: :lg)
      div
        .students-page__hero-title
          h1 = name
        - if student[:email].present?
          p.students-page__hero-email = student[:email]
        p.students-page__hero-course = student_subject_line(student)
    .students-page__hero-actions
      - current_status = student[:status].to_s.presence || 'active'
      = form_with url: student_path(student[:id]), method: :patch, html: { class: 'students-page__status-form' } do
        = hidden_field_tag :status_only, '1'
        = hidden_field_tag :status, current_status, data: { students_target: 'statusValue' }
        .students-page__status-menu
          button.students-page__status-btn type="button" aria-label=t('app.students.status') aria-haspopup="listbox" aria-expanded="false" data-students-target="statusButton" data-action="click->students#toggleStatusMenu:stop"
            span.status-badge class="status-badge--#{student_status_tone(current_status)}" data-students-target="statusBadge" = student_status_label(current_status)
            = icon_tag 'chevron-down', size: 16
          .students-page__status-panel hidden="hidden" role="listbox" data-students-target="statusMenu" data-action="click->students#stopStatusMenu:stop"
            - StudentProfile.statuses.each_key do |value|
              button.students-page__status-option class=('is-current' if current_status == value.to_s) type="button" role="option" aria-selected=(current_status == value.to_s ? 'true' : 'false') data-status=value data-label=student_status_label(value) data-tone=student_status_tone(value) data-action="click->students#chooseStatus:stop"
                span.status-badge class="status-badge--#{student_status_tone(value)}" = student_status_label(value)
      = link_to edit_student_path(student[:id]), class: 'students-page__ghost-btn' do
        = icon_tag 'pencil', size: 18
        span = t('app.students.edit_student')
      = link_to new_calendar_path(student_id: student[:id]), class: 'students-page__create-btn', data: calendar_create_turbo_data do
        = icon_tag 'calendar-plus', size: 18
        span = t('app.students.create_lesson')
      .students-page__menu
        button.students-page__icon-action type="button" aria-label=t('app.students.more_actions') aria-expanded="false" data-students-target="menuButton" data-action="click->students#toggleMenu:stop"
          = icon_tag 'dots', size: 18
        .students-page__menu-panel hidden="hidden" data-students-target="menu" data-action="click->students#closeMenu:stop"
          button.students-page__menu-item type="button" data-action="students#shareMaterial"
            = icon_tag 'folder-plus', size: 16
            span = t('app.students.share_material')
          = link_to calendar_path(studentId: student[:id]), class: 'students-page__menu-item' do
            = t('app.students.open_calendar')
          = link_to students_path, class: 'students-page__menu-item' do
            = t('app.students.back')
          - unless student[:status].to_s == 'archived'
            a.students-page__menu-item href=student_delete_dialog_path(student) data-turbo="true" data-turbo-frame="delete_dialog"
              = icon_tag 'trash', size: 16
              span = t('app.students.delete')
