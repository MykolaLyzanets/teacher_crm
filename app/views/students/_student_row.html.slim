- name = student_display_name(student)
- teacher = teachers.find { |t| t[:id].to_s == student[:teacherId].to_s }
- teacher_name = teacher ? (teacher[:displayName].presence || [teacher[:firstName], teacher[:lastName]].compact_blank.join(' ')) : student[:teacher]

li.students-page__row[
  data-students-target="row"
  data-name=name.downcase
  data-email=(student[:email].to_s.downcase)
  data-status=student[:status]
  data-teacher-id=(student[:teacherId].presence || '')
  data-assigned=(student[:teacherId].present? ? '1' : '0')
  data-created=(student[:createdAt].to_s)
]
  .students-page__cell
    input type="checkbox" aria-label="Select #{name}" data-students-target="checkbox" data-action="change->students#syncSelection" data-id=student[:id]
  .students-page__cell.students-page__student
    span.students-page__avatar = student_initials(student)
    div
      = link_to name, student_path(student[:id]), class: 'students-page__name'
      p.students-page__meta
        - if student[:parentName].present?
          | Parent: #{student[:parentName]}
        - else
          = student[:studentCode].presence || 'No parent listed'
  .students-page__cell.students-page__contact
    p = student[:email].presence || 'No email'
    p = student[:phone].presence || 'No phone'
  .students-page__cell.students-page__grade = student[:grade].presence || '—'
  .students-page__cell.students-page__teacher
    - if teacher_name.present?
      button.students-page__teacher-btn type="button" data-action="students#openAssignFor" data-id=student[:id]
        span.students-page__avatar.students-page__avatar--sm
          - if teacher
            = teacher[:firstName].to_s[0]
            = teacher[:lastName].to_s[0]
          - else
            | T
        span = teacher_name
    - else
      .students-page__assign-wrap
        span.status-badge.status-badge--neutral Unassigned
        button.students-page__assign-btn type="button" data-action="students#openAssignFor" data-id=student[:id]
          = icon_tag 'user-plus', size: 14
          | Assign
  .students-page__cell
    span class="status-badge status-badge--#{student_status_tone(student[:status])}" = student_status_label(student[:status])
  .students-page__cell.students-page__align-right
    = link_to 'View', student_path(student[:id]), class: 'students-page__view-btn'
