- content_for :title, 'Students | danlio'

.students-page data-controller="students"
  .students-page__header
    div
      h1.students-page__title Students
      p.students-page__subtitle Manage student profiles, contacts and learning details.
    = link_to new_student_path, class: 'students-page__primary-btn' do
      = icon_tag 'plus', size: 20
      span Add student

  = render 'stats', stats: @stats

  section.students-page__panel
    .students-page__toolbar
      .students-page__toolbar-row
        .students-page__search
          = icon_tag 'search', size: 18
          input type="search" placeholder="Search students…" aria-label="Search students" data-students-target="search" data-action="input->students#filter"
        .students-page__filters
          select aria-label="Filter by status" data-students-target="status" data-action="change->students#filter"
            option value="" All statuses
            option value="active" Active
            option value="trial" Trial
            option value="paused" Paused
            option value="archived" Archived
          select aria-label="Filter by teacher assignment" data-students-target="teacher" data-action="change->students#filter"
            option value="all" All teachers
            option value="assigned" Assigned
            option value="unassigned" Unassigned
            - @teachers.each do |teacher|
              - name = teacher[:displayName].presence || [teacher[:firstName], teacher[:lastName]].compact_blank.join(' ')
              option value=teacher[:id] = name

      .students-page__bulk.students-page__bulk--hidden data-students-target="bulk"
        p data-students-target="bulkCount" 0 selected
        button.students-page__secondary-btn type="button" data-action="students#openAssign" Assign teacher

    .students-page__empty.students-page__empty--hidden data-students-target="empty"
      .students-page__empty-icon
        = icon_tag 'students', size: 24
      h2 data-students-target="emptyTitle" No students match your filters
      p data-students-target="emptyText" Try a different search or clear the filters.
      = link_to new_student_path, class: 'students-page__primary-btn students-page__empty-add students-page__empty-add--hidden', data: { students_target: 'addBtn' } do
        = icon_tag 'plus', size: 20
        span Add student

    .students-page__table-wrap data-students-target="table"
      .students-page__table-head
        span
          input type="checkbox" aria-label="Select all visible students" data-students-target="selectAll" data-action="change->students#toggleAll"
        span Student
        span Contact
        span Grade
        span Teacher
        span Status
        span.students-page__align-right Actions
      ul.students-page__list
        - @students.each do |student|
          = render 'student_row', student: student, teachers: @teachers

  .students-page__dialog[hidden] data-students-target="dialog"
    .students-page__dialog-backdrop data-action="click->students#closeAssign"
    .students-page__dialog-card role="dialog" aria-modal="true" aria-labelledby="assign-teacher-title"
      h2#assign-teacher-title Assign teacher
      p Choose a teacher for the selected students.
      select data-students-target="assignSelect"
        option value="" Select teacher
        - @teachers.each do |teacher|
          - name = teacher[:displayName].presence || [teacher[:firstName], teacher[:lastName]].compact_blank.join(' ')
          option value=teacher[:id] = name
      .students-page__dialog-actions
        button.students-page__secondary-btn type="button" data-action="students#closeAssign" Cancel
        button.students-page__primary-btn type="button" data-action="students#confirmAssign" Confirm
