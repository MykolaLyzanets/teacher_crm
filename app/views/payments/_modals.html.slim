      .pay__modal-stack
        .pay__modal-form
          .pay__fields
            label.pay__field
              span.pay__label
                = t('app.payments.amount')
                span.pay__required *
              input.pay__input type="number" min="0" step="1" inputmode="decimal" autofocus="autofocus" data-payments-target="payoutAmount"
            label.pay__field
              span.pay__label = t('app.payments.col_currency')
              input.pay__input type="text" readonly="readonly" data-payments-target="payoutCurrency"
            label.pay__field
              span.pay__label
                = t('app.payments.payment_date')
                span.pay__required *
              input.pay__input type="date" data-payments-target="payoutDate"
