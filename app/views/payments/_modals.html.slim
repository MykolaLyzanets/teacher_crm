    .danlio-modal__foot
      button.danlio-modal__btn.danlio-modal__btn--secondary type="button" data-action="payments#closePayoutModal" = t('app.common.cancel')
      button.danlio-modal__btn.danlio-modal__btn--primary type="button" data-action="payments#savePayout" = t('app.payments.record_payout_submit')

