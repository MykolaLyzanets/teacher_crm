              span.pay__label
                = t('app.payments.payment_method')
                span.pay__required *
              select.pay__input data-payments-target="payoutMethod"
                - payment_method_keys.each do |method_key|
                  option value=method_key = t("app.payments.methods.#{method_key}")
            label.pay__field
              span.pay__label = t('app.payments.note_internal')
              textarea.pay__input rows="3" placeholder=t('app.payments.payout_note_placeholder') data-payments-target="payoutNote"
