- content_for :title, "#{t('app.payments.title')} | danlio"

- if @forbidden
  .pay.pay--denied
    .pay__denied-icon
      = icon_tag 'payments', size: 24
    h1 = t('app.payments.title')
    p = t('app.payments.forbidden_text')
- else
  .pay data={ controller: 'payments', payments_i18n_value: app_i18n_json('app.payments', 'app.common'), payments_can_manage_value: can_manage_payments?.to_s, payments_paths_value: { studentPayment: payments_student_payment_path, confirmPayment: payments_confirm_payment_path, rejectPayment: payments_reject_payment_path, adjustment: payments_adjustment_path, teacherPayout: payments_teacher_payout_path, refund: payments_refund_path }.to_json }
    p.pay__toast hidden="hidden" role="status" data-payments-target="toast"

    header.pay__header
      h1 = t('app.payments.title')
      p = t('app.payments.subtitle')

    .pay__tabs role="tablist" aria-label=t('app.payments.tabs_aria')
      - %w[overview balances payouts transactions].each do |tab|
        button.pay__tab type="button" role="tab" aria-selected=(tab == 'overview' ? 'true' : 'false') data-payments-target="tab" data-tab=tab data-action="payments#selectTab"
          = t("app.payments.tab_#{tab}")

    .pay__panel data-payments-target="panel" data-tab="overview"
      .pay__cards
        .pay__card
          span.pay__card-icon
            = icon_tag 'payments', size: 22
          span
            span.pay__card-label = t('app.payments.received')
            strong = grouped_money_label(@overview[:paymentsReceived])
            span.pay__card-hint = t('app.payments.received_hint')
        .pay__card
          span.pay__card-icon
            = icon_tag 'book', size: 22
          span
            span.pay__card-label = t('app.payments.lesson_revenue')
            strong = grouped_money_label(@overview[:lessonRevenue])
            span.pay__card-hint = t('app.payments.lesson_revenue_hint')
        .pay__card class=("is-warn" if @overview[:outstandingDebt].values.sum.positive?)
          span.pay__card-icon
            = icon_tag 'bell', size: 22
          span
            span.pay__card-label = t('app.payments.outstanding_debt')
            strong = grouped_money_label(@overview[:outstandingDebt])
            span.pay__card-hint = t('app.payments.outstanding_hint')
        - if @school
          .pay__card
            span.pay__card-icon
              = icon_tag 'teachers', size: 22
            span
              span.pay__card-label = t('app.payments.teacher_earnings')
              strong = grouped_money_label(@overview[:teacherEarnings])
              span.pay__card-hint = t('app.payments.teacher_earnings_hint')
          .pay__card
            span.pay__card-icon
              = icon_tag 'check', size: 22
            span
              span.pay__card-label = t('app.payments.teacher_payouts')
              strong = grouped_money_label(@overview[:teacherPayouts])
              span.pay__card-hint = t('app.payments.teacher_payouts_hint')
          .pay__card
            span.pay__card-icon
              = icon_tag 'chart-bars', size: 22
            span
              span.pay__card-label = t('app.payments.school_profit')
              strong = grouped_money_label(@overview[:schoolGrossProfit])
              span.pay__card-hint = t('app.payments.school_profit_hint')
        - else
          .pay__card
            span.pay__card-icon
              = icon_tag 'chart-bars', size: 22
            span
              span.pay__card-label = t('app.payments.your_revenue')
              strong = grouped_money_label(@overview[:lessonRevenue])
              span.pay__card-hint = t('app.payments.your_revenue_hint')

    .pay__panel hidden="hidden" data-payments-target="panel" data-tab="balances"
      - if @balances.blank?
        .pay__empty-state
          .pay__empty-icon
            = icon_tag 'receipt', size: 24
          h2 = t('app.payments.no_students')
      - else
        section.pay__table-card
          .pay__table-wrap
            table.pay__table
              thead
                tr
                  th = t('app.payments.col_student')
                  th = t('app.payments.col_teacher')
                  th = t('app.payments.col_balance')
                  th = t('app.payments.col_owed')
                  th = t('app.payments.col_covered')
                  th = t('app.payments.col_next')
                  th = t('app.payments.col_status')
                  th.pay__actions = t('app.payments.col_actions')
              tbody
                - @balances.each do |row|
                  tr.pay__row
                    td
                      - if row[:profileId].present?
                        = link_to row[:name], student_path(row[:profileId], tab: 'payments'), class: 'pay__link'
                      - else
                        strong = row[:name]
                    td.pay__muted = row[:teacher]
                    td class=pay_balance_value_class(row[:balanceCents], row[:healthStatus])
                      = signed_money_label(row[:balanceCents], row[:currency])
                    td
                      - if row[:outstandingCents].to_i.positive?
                        span.pay-balance--debt = money_label(row[:outstandingCents], row[:currency])
                      - else
                        | —
                    td.pay__muted
                      - if row[:upcomingCount].to_i.positive?
                        = t('app.payments.lessons_covered_of', covered: row[:lessonsCovered], total: row[:upcomingCount])
                      - else
                        | —
                    td.pay__muted
                      = row[:nextLessonDate].present? ? format_lesson_day_short(row[:nextLessonDate]) : '—'
                    td
                      .pay__badges
                        = pay_health_status_badge(row[:healthStatus])
                        - if row[:pendingCount].to_i.positive?
                          = pay_pending_payment_badge
                    td.pay__actions
                      .pay__row-actions
                        - if can_manage_payments?
                          button.pay__text-link type="button" data-action="payments#openPayment" data-student-id=row[:profileId] data-student-name=row[:name] data-currency=row[:currency] data-balance-cents=row[:balanceCents] data-reference-price-cents=row[:referencePriceCents]
                            = t('app.payments.add_funds')
                          button.pay__text-link type="button" data-action="payments#openAdjustment" data-student-id=row[:profileId] data-student-name=row[:name] data-currency=row[:currency] data-balance-cents=row[:balanceCents] data-reference-price-cents=row[:referencePriceCents]
                            = t('app.payments.adjust')
                        - if row[:profileId].present?
                          = link_to t('app.payments.link_transactions'), student_path(row[:profileId], tab: 'payments'), class: 'pay__text-link'
                        - else
                          button.pay__text-link type="button" data-action="payments#focusStudentTransactions" data-student-id=row[:profileId]
                            = t('app.payments.link_transactions')

    .pay__panel hidden="hidden" data-payments-target="panel" data-tab="payouts"
      - if @payouts.blank?
        .pay__empty-state
          .pay__empty-icon
            = icon_tag 'teachers', size: 24
          h2 = t('app.payments.no_teachers')
      - else
        section.pay__table-card
          .pay__table-wrap
            table.pay__table
              thead
                tr
                  th = t('app.payments.col_teacher')
                  th = t('app.payments.col_completed')
                  th = t('app.payments.col_hours')
                  th = t('app.payments.col_earnings')
                  th = t('app.payments.col_paid')
                  th = t('app.payments.col_remaining')
                  th.pay__actions = t('app.payments.col_actions')
              tbody
                - @payouts.each do |row|
                  - summary = row[:summary]
                  tr
                    td
                      - if row[:profileId].present?
                        = link_to row[:name], teacher_path(row[:profileId]), class: 'pay__link'
                      - else
                        strong = row[:name]
                    td.pay__muted = summary[:completedLessons]
                    td.pay__muted = summary[:teachingHours]
                    td = money_label(summary[:totalEarningsCents], summary[:currency])
                    td = money_label(summary[:paidCents], summary[:currency])
                    td
                      strong = money_label(summary[:remainingCents], summary[:currency])
                    td.pay__actions
                      .pay__row-actions
                        - if row[:profileId].present?
                          = link_to t('app.payments.view_earnings'), teacher_path(row[:profileId]), class: 'pay__text-link'
                        button.pay__text-link type="button" data-action="payments#openPayout" data-teacher-id=row[:profileId] data-teacher-name=row[:name] data-remaining=summary[:remainingCents] data-currency=summary[:currency]
                          = t('app.payments.record_payout')

    .pay__panel hidden="hidden" data-payments-target="panel" data-tab="transactions"
      .pay__filters-bar
        = icon_tag 'filter', size: 18, class: 'pay__filter-icon'
        input.pay__filter type="date" aria-label=t('app.payments.from_date') data-payments-target="from" data-action="change->payments#filter"
        input.pay__filter type="date" aria-label=t('app.payments.to_date') data-payments-target="to" data-action="change->payments#filter"
        select.pay__filter data-payments-target="type" data-action="change->payments#filter" aria-label=t('app.payments.col_type')
          option value="all" = t('app.payments.all_types')
          - %w[payment lesson_charge cancellation_charge refund adjustment teacher_earning teacher_payout].each do |kind|
            option value=kind = t("app.payments.types.#{kind}")
        select.pay__filter data-payments-target="student" data-action="change->payments#filter" aria-label=t('app.payments.col_student')
          option value="all" = t('app.payments.all_students')
          - Array(@students).each do |student|
            option value=student[:id] = student[:name]
        select.pay__filter data-payments-target="status" data-action="change->payments#filter" aria-label=t('app.payments.col_status')
          option value="all" = t('app.payments.all_statuses')
          option value="pending" = t('app.payments.status_payment_pending')
          option value="rejected" = t('app.payments.rejected')
          option value="reversed" = t('app.payments.status_reversed')

      - if @transactions.blank?
        .pay__empty-state
          .pay__empty-icon
            = icon_tag 'receipt', size: 24
          h2 = t('app.payments.no_transactions')
          p = t('app.payments.empty_filter_hint')
      - else
        section.pay__table-card
          .pay__table-wrap
            table.pay__table
              thead
                tr
                  th = t('app.payments.col_date')
                  th = t('app.payments.col_type')
                  th = t('app.payments.col_party')
                  th = t('app.payments.col_description')
                  th = t('app.payments.col_amount')
                  th.pay__actions = t('app.payments.col_actions')
              tbody data-payments-target="transactionBody"
                - @transactions.each do |item|
                  tr data-payments-target="row" data-date=item[:date] data-type=item[:kind] data-status=item[:status] data-student-id=item[:studentId] data-currency=item[:currency] data-payment-id=item[:paymentId]
                    td = item[:date]
                    td
                      = t("app.payments.types.#{item[:kind]}", default: item[:kind].to_s.humanize)
                      - if item[:status].present?
                        span.pay-badge class="pay-badge--#{item[:status] == 'pending' ? 'amber' : item[:status] == 'rejected' ? 'rose' : 'neutral'}"
                          = t("app.payments.tx_status_#{item[:status]}", default: item[:status])
                    td.pay__muted = item[:party].presence || '—'
                    td = item[:description]
                    td class=(item[:amountCents].to_i.negative? ? 'is-neg' : 'is-pos')
                      = signed_money_label(item[:amountCents], item[:currency])
                    td.pay__actions
                      - if item[:status].to_s == 'pending' && item[:paymentId].present? && can_manage_payments?
                        .pay__row-actions
                          button.pay__text-link type="button" data-action="payments#confirmPending" data-payment-id=item[:paymentId] = t('app.payments.confirm')
                          button.pay__text-link.pay__text-link--danger type="button" data-action="payments#rejectPending" data-payment-id=item[:paymentId] = t('app.payments.reject')
                      - elsif item[:refundPaymentId].present? && item[:refundableCents].to_i.positive? && can_manage_payments?
                        .pay__row-actions
                          button.pay__text-link type="button" data-action="payments#openRefund" data-payment-id=item[:refundPaymentId] data-refundable-cents=item[:refundableCents] data-payment-cents=item[:originalPaymentCents] data-currency=item[:currency] data-party=item[:party] = t('app.payments.refund')
                      - else
                        span.pay__muted-right —
          .pay__empty-state hidden="hidden" data-payments-target="empty"
            .pay__empty-icon
              = icon_tag 'receipt', size: 24
            h2 = t('app.payments.no_transactions')
            p = t('app.payments.empty_filter_hint')

    = render 'payments/modals'
