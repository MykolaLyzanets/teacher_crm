- content_for :title, "#{t('app.student_portal.pages.calendar.title')} | danlio"
- labels = student_calendar_labels
- assignment_url_template = student_homework_assignment_path('_ID_').sub('_ID_', ':id')
- response_url_template = homework_response_path('_ID_').sub('_ID_', ':id')
- submit_url_template = submit_homework_response_path('_ID_').sub('_ID_', ':id')

.sp-calendar[
  data-controller="student-calendar student-homework"
  data-student-calendar-labels-value=labels.to_json
  data-student-calendar-lessons-value=student_calendar_lessons_json.to_json
  data-student-homework-assignment-url-value=assignment_url_template
  data-student-homework-response-url-value=response_url_template
  data-student-homework-submit-url-value=submit_url_template
  data-student-homework-labels-value=student_homework_labels.to_json
]
  section.sp-upcoming hidden="hidden" aria-label="#{t('app.student_portal.calendar.next_lesson')}" data-student-calendar-target="upcoming"
    p.sp-upcoming__label = t('app.student_portal.calendar.next_lesson')
    h2.sp-upcoming__title data-student-calendar-target="upcomingTitle"
    .sp-upcoming__meta
      span.sp-upcoming__item
        = portal_icon 'calendar', size: 16
        span data-student-calendar-target="upcomingWhen"
      span.sp-upcoming__item
        = portal_icon 'user', size: 16
        span data-student-calendar-target="upcomingWho"
    .sp-upcoming__actions
      a.sp-btn.sp-btn--primary href="#" target="_blank" rel="noreferrer" hidden="hidden" data-student-calendar-target="upcomingJoin" = t('app.student_portal.calendar.join')
      button.sp-btn.sp-btn--ghost type="button" data-action="student-calendar#openUpcoming" = t('app.student_portal.calendar.view_details')

  section.sp-cal
    .sp-cal__toolbar
      .sp-cal__nav
        button.sp-cal__icon-btn type="button" aria-label="#{t('app.student_portal.calendar.previous')}" data-action="student-calendar#previous"
          = portal_icon 'chevron-left', size: 20
        button.sp-cal__today type="button" data-action="student-calendar#today" = t('app.student_portal.calendar.today')
        button.sp-cal__icon-btn type="button" aria-label="#{t('app.student_portal.calendar.next')}" data-action="student-calendar#next"
          = portal_icon 'chevron-right', size: 20
        h2.sp-cal__title data-student-calendar-target="title"

      .sp-cal__views
        .sp-cal__tabs role="tablist" aria-label="#{t('app.student_portal.calendar.view_label')}"
          button.sp-cal__tab.is-active type="button" role="tab" aria-selected="true" data-view="month" data-student-calendar-target="viewTab" data-action="student-calendar#setView" = t('app.student_portal.calendar.month')
          button.sp-cal__tab type="button" role="tab" aria-selected="false" data-view="week" data-student-calendar-target="viewTab" data-action="student-calendar#setView" = t('app.student_portal.calendar.week')
          button.sp-cal__tab type="button" role="tab" aria-selected="false" data-view="agenda" data-student-calendar-target="viewTab" data-action="student-calendar#setView" = t('app.student_portal.calendar.agenda')

        label.sr-only for="student-calendar-view" = t('app.student_portal.calendar.view_label')
        select#student-calendar-view.sp-cal__select data-student-calendar-target="viewSelect" data-action="student-calendar#setView"
          option value="month" selected="selected" = t('app.student_portal.calendar.month')
          option value="week" = t('app.student_portal.calendar.week')
          option value="agenda" = t('app.student_portal.calendar.agenda')

    .sp-cal__month data-student-calendar-target="month"
      .sp-cal__weekdays
        - labels[:weekdays].each do |label|
          div = label
      .sp-cal__grid data-student-calendar-target="monthGrid"

    .sp-cal__week hidden="hidden" data-student-calendar-target="week"
      .sp-cal__week-scroll
        .sp-cal__week-grid data-student-calendar-target="weekGrid"

    .sp-cal__agenda hidden="hidden" data-student-calendar-target="agenda"
      .sp-cal__agenda-empty
        .sp-cal__agenda-icon
          = portal_icon 'calendar', size: 24
        h3 = t('app.student_portal.calendar.empty_title')
        p = t('app.student_portal.calendar.empty_text')

    .sp-cal__day-agenda hidden="hidden" data-student-calendar-target="dayAgenda"
      .sp-cal__day-agenda-head
        p = t('app.student_portal.calendar.selected_day')
        h3 data-student-calendar-target="dayAgendaTitle"
      p.sp-cal__day-empty data-student-calendar-target="dayAgendaEmpty"

    .sp-cal__chip data-student-calendar-target="emptyChip"
      .sp-cal__chip-card
        = portal_icon 'calendar', size: 20
        div
          p.sp-cal__chip-title = t('app.student_portal.calendar.empty_title')
          p.sp-cal__chip-text = t('app.student_portal.calendar.empty_text')

  .sp-drawer.sp-drawer--lesson.sp-drawer--hidden data-student-calendar-target="drawer"
    button.sp-drawer__backdrop type="button" aria-label="#{t('app.common.close')}" data-action="student-calendar#closeDetails"
    aside.sp-drawer__panel role="dialog" aria-modal="true" aria-labelledby="student-lesson-title"
      .sp-drawer__head.sp-lesson-drawer__head
        div
          h2#student-lesson-title data-student-calendar-target="drawerTitle"
          p.sp-lesson-drawer__sub data-student-calendar-target="drawerSubtitle"
          .sp-lesson-drawer__badges data-student-calendar-target="drawerBadges"
        button.sp-icon-btn type="button" aria-label="#{t('app.common.close')}" data-action="student-calendar#closeDetails"
          = portal_icon 'x', size: 20
      .sp-drawer__body.sp-lesson-drawer__body
        .sp-lesson-drawer__banner hidden="hidden" data-student-calendar-target="drawerBanner"
        .sp-lesson-drawer__section
          h3.sp-lesson-drawer__kicker = t('app.student_portal.calendar.lesson_teacher')
          .sp-lesson-drawer__teacher-card
            span.sp-lesson-drawer__avatar data-student-calendar-target="drawerTeacherInitials"
            div
              p.sp-lesson-drawer__teacher-name data-student-calendar-target="drawerTeacher"
              p.sp-lesson-drawer__muted data-student-calendar-target="drawerTeacherRole"
        .sp-lesson-drawer__section
          h3.sp-lesson-drawer__kicker = t('app.student_portal.calendar.lesson_datetime')
          dl.sp-lesson-drawer__facts
            dt = t('app.student_portal.calendar.lesson_date')
            dd data-student-calendar-target="drawerDate"
            dt = t('app.student_portal.calendar.lesson_time')
            dd data-student-calendar-target="drawerWhen"
            dt = t('app.student_portal.calendar.lesson_type')
            dd data-student-calendar-target="drawerLessonType"
            dt = t('app.student_portal.calendar.lesson_timezone')
            dd data-student-calendar-target="drawerTimezone"
            dt = t('app.student_portal.calendar.lesson_location')
            dd data-student-calendar-target="drawerPlace"
        .sp-lesson-drawer__section
          h3.sp-lesson-drawer__kicker
            = portal_icon 'homework', size: 16
            span = t('app.student_portal.calendar.lesson_homework')
          .sp-lesson-drawer__hw-empty hidden="hidden" data-student-calendar-target="drawerHomeworkEmpty"
            p = t('app.student_portal.calendar.lesson_homework_empty')
          .sp-lesson-drawer__hw-list data-student-calendar-target="drawerHomeworkList"
        .sp-lesson-drawer__section hidden="hidden" data-student-calendar-target="drawerNotesSection"
          h3.sp-lesson-drawer__kicker = t('app.student_portal.calendar.lesson_notes')
          p.sp-lesson-drawer__note data-student-calendar-target="drawerNotes"
      .sp-drawer__foot
        a.sp-btn.sp-btn--primary href="#" target="_blank" rel="noreferrer" hidden="hidden" data-student-calendar-target="drawerJoin" = t('app.student_portal.calendar.join')
        button.sp-btn.sp-btn--ghost type="button" data-action="student-calendar#closeDetails" = t('app.common.close')

  = render 'student_portal/homework_drawer'
