aside.student-portal__sidebar aria-label="#{t('app.student_portal.nav.main')}"
  .student-portal__brand
    = link_to student_calendar_path, aria: { label: t('app.student_portal.home') } do
      = image_tag 'brand/danlio-logo.svg', alt: 'danlio', height: 34

  nav.student-portal__nav
    - student_nav_items.each do |item|
      - active = student_nav_active?(item[:action])
      = link_to item[:path], class: "student-portal__link#{" is-active" if active}", aria: ({ current: 'page' } if active) do
        span.student-portal__icon
          = portal_icon item[:icon], size: 20
        span.student-portal__label = item[:label]
        - badge = item[:action] == 'homework' ? @homework_badge.to_i : (item[:action] == 'materials' ? @materials_badge.to_i : 0)
        - if badge.positive?
          span.student-portal__badge = badge > 9 ? '9+' : badge

  .student-portal__sidebar-footer
    = render 'student_portal/profile_menu', variant: :sidebar
