nav.student-portal__mobile-nav aria-label="#{t('app.student_portal.nav.main')}"
  ul
    - student_nav_items.each do |item|
      - active = student_nav_active?(item[:action])
      li
        = link_to item[:path], class: "student-portal__tab#{" is-active" if active}", aria: ({ current: 'page' } if active) do
          = portal_icon item[:icon], size: 20
          span = item[:label]
