- lesson_materials = lesson_materials_list(lesson)
- attachable = editable ? lesson_attachable_materials(lesson) : Material.none
section.lessons-page__show-section#lesson-materials
  .lessons-page__section-head
    h3.lessons-page__show-kicker
      span.lessons-page__section-icon = lesson_icon 'folder', size: 16
      = t('app.lessons.materials')
  - if flash[:notice].present? || flash[:alert].present?
    p.lessons-page__form-flash class=(flash[:alert].present? ? 'is-error' : nil)
      = flash[:alert].presence || flash[:notice]
  - if lesson_materials.any?
    ul.lessons-page__material-list
      - lesson_materials.each do |material|
        li.lessons-page__material-row
          span.lessons-page__material-row-icon = lesson_icon(material.kind_link? ? 'link' : 'file', size: 16)
          span.lessons-page__material-row-copy
            - if material.access_url.present?
              a.lessons-page__text-link href=material.access_url target="_blank" rel="noreferrer" = material.title
            - else
              span = material.title
            span.lessons-page__muted = t("app.student_portal.materials.types.#{material.kind}", default: material.kind.humanize)
  - else
    p.lessons-page__muted = t('app.lessons.no_materials')
  - if editable
    .lessons-page__material-forms
      = form_with url: lesson_materials_path(lesson[:id]), method: :post, html: { multipart: true, data: { turbo_frame: 'lesson_details' }, class: 'lessons-page__material-form' } do
        p.lessons-page__material-form-title = t('app.lessons.add_material')
        label.lessons-page__field
          span = t('app.homework.link_title_placeholder')
          input type="text" name="title" placeholder=t('app.homework.link_title_placeholder')
        label.lessons-page__field
          span = t('app.lessons.material_link_url')
          input type="url" name="external_url" placeholder="https://" required="required"
        button.lessons-page__secondary-btn.lessons-page__compact-btn type="submit"
          = lesson_icon 'link', size: 16
          span = t('app.lessons.add_material_link')
      = form_with url: lesson_materials_path(lesson[:id]), method: :post, html: { multipart: true, data: { turbo_frame: 'lesson_details' }, class: 'lessons-page__material-form' } do
        p.lessons-page__material-form-title = t('app.lessons.upload_material')
        label.lessons-page__field
          span = t('app.homework.attach_files')
          input type="file" name="file" accept="application/pdf,image/*,audio/*,video/mp4,video/quicktime,video/webm"
        label.lessons-page__field
          span = t('app.homework.link_title_placeholder')
          input type="text" name="title" placeholder=t('app.homework.link_title_placeholder')
        button.lessons-page__primary-btn.lessons-page__compact-btn type="submit"
          = lesson_icon 'upload', size: 16
          span = t('app.lessons.add_material')
      - if attachable.any?
        = form_with url: lesson_materials_path(lesson[:id]), method: :post, html: { data: { turbo_frame: 'lesson_details' }, class: 'lessons-page__material-form' } do
          p.lessons-page__material-form-title = t('app.lessons.share_existing')
          label.lessons-page__field
            span = t('app.homework.attach_from_materials')
            select name="material_id"
              option value="" = t('app.lessons.choose_material')
              - attachable.each do |item|
                option value=item.id = item.title
          button.lessons-page__secondary-btn.lessons-page__compact-btn type="submit"
            = lesson_icon 'folder-plus', size: 16
            span = t('app.lessons.share_existing')
